---
// Location — Proto A: full green slide, everything centered (continues A's
// centered About direction and restores the green brand beat the retired
// manifesto used to carry). Copy per the Aug 24 web-copy doc.
// Chunks use the page-level data-rv reveal (armed by the index script).
import SignupButton from './SignupButton.astro';

const BODY = [
  'For eight weeks, kids ages 8–13 will take an idea and build it into a real business.',
  'They can come in knowing what they want to make. Or with no idea at all.',
  'They build a brand, a product, a plan and a pitch they deliver in front of a room at the end of the semester.',
  'Along the way, they’ll figure things out by doing them. Make decisions. Be creative. Talk to people. Understand money. Use the same tools people use to build businesses every day.',
];
---

<section class="fc-location" id="location" aria-labelledby="location-title">
  <div class="inner">
    <h2 id="location-title" data-rv style="--rvi: 0">
      STAND is coming to Los&nbsp;Angeles
    </h2>

    <p class="lede" data-rv style="--rvi: 1">
      This fall, we&rsquo;re opening our first STAND location in West&nbsp;LA!
    </p>

    <div class="body">
      {
        BODY.map((line, i) => (
          <p data-rv style={`--rvi: ${2 + i}`}>
            {line}
          </p>
        ))
      }
    </div>

    <p class="closer" data-rv style="--rvi: 6">
      Because some things you only learn by actually doing them.
    </p>

    <div class="cta" data-rv style="--rvi: 7">
      <SignupButton label="get first access" />
    </div>
  </div>
</section>

<style>
  .fc-location {
    background: var(--stand-green);
    color: var(--stand-white);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(20px, 2.2vw, 32px);
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(64px, 7.7vw, 111px) 48px clamp(56px, 6.3vw, 90px);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 4.4vw, 64px);
    line-height: 1.02;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  /* Post-it yellow serif lede — the warm accent on green. */
  .lede {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(20px, 2.2vw, 32px);
    line-height: 1.3;
    color: var(--stand-postit);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.5vw, 22px);
    /* Full column, not a reading measure — the short beats should each sit
       on a single line at desktop widths. */
    max-width: none;
  }

  .body p {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .closer {
    margin: clamp(8px, 1vw, 16px) 0 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.3;
  }

  .cta {
    margin-top: clamp(8px, 1vw, 16px);
    display: flex;
    justify-content: center;
    align-self: stretch;
  }

  @media (max-width: 768px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
