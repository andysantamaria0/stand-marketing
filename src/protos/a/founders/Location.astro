---
// Location — shared (A/B/C): "week-by-week, scannable" (comp 1E, Aug 24). Heavy
// sans announcement + red lede + CTA in the left rail; right column runs the
// eight-week intro over a rule, the week table with red week labels, the
// mentorship paragraph, and the learn-by-doing closer.
// Chunks use the page-level data-rv reveal (armed by the index script).
import SignupButton from './SignupButton.astro';

const WEEKS = [
  { label: 'Week 1–2', text: 'Find the idea.' },
  { label: 'Week 3–7', text: 'Build the brand, the product and the plan.' },
  { label: 'Week 8', text: 'Pitch it live in front of a room.' },
];
---

<section class="fc-location" id="location" aria-labelledby="location-title">
  <div class="grid">
    <header class="rail">
      <h2 id="location-title" data-rv style="--rvi: 0">
        <span class="logo-word" role="img" aria-label="Stand"></span> is coming to Los&nbsp;Angeles!
      </h2>
      <p class="lede" data-rv style="--rvi: 1">
        Our first location opens this fall in&nbsp;LA!
      </p>
      <div class="cta" data-rv style="--rvi: 2">
        <SignupButton label="Get first access" />
      </div>
    </header>

    <div class="detail">
      <p class="intro" data-rv style="--rvi: 3">
        For eight weeks, kids ages 8&ndash;13 take an idea and turn it into a
        real business.
      </p>

      <dl class="weeks" data-rv style="--rvi: 4">
        <div class="rows">
          {
            WEEKS.map((w) => (
              <div class="week">
                <dt>{w.label}</dt>
                <dd>{w.text}</dd>
              </div>
            ))
          }
        </div>
      </dl>

      <p class="para" data-rv style="--rvi: 5">
        Along the way, they&rsquo;ll get hands-on mentorship, build alongside
        other kids, and use digital tools to help bring their ideas to life.
      </p>

      <p class="para" data-rv style="--rvi: 6">
        Because some things you only learn by doing them.
      </p>
    </div>
  </div>
</section>

<style>
  .fc-location {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 5vw, 72px);
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 6.1vw, 88px) 48px clamp(56px, 6.3vw, 90px);
  }

  .rail {
    position: sticky;
    top: 96px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.7vw, 24px);
  }

  /* Pie Pie announcement (Aug 24 review). Sentence case as written (JY,
     Aug 25: "is coming to" stays lowercase) — no transform; the markup's
     own casing renders. */
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 3.8vw, 56px);
    line-height: 1.02;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  /* PROTO A: "Stand" set as the actual wordmark — logo.svg as a currentColor
     mask (same technique as the nav), sized to the headline's cap height so
     it sits on the baseline like a word, not a badge. */
  h2 .logo-word {
    display: inline-block;
    height: 0.72em;
    aspect-ratio: 199.29 / 47.33;
    background: currentColor;
    -webkit-mask: url('/brand/logo.svg') no-repeat center / contain;
    mask: url('/brand/logo.svg') no-repeat center / contain;
  }

  .lede {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--stand-black);
  }

    .cta :global(.signup) {
    min-width: 0;
    align-self: flex-start;
  }

  .detail {
    display: flex;
    flex-direction: column;
  }

  .intro,
  .para {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /* Receipt-dash rules above and below the week table — fine 6px dashes
     (the ProgramFacts recipe; border: dashed can't control dash length). */
  .weeks {
    margin: clamp(18px, 2vw, 28px) 0 0;
    padding: clamp(18px, 2vw, 28px) 0;
    --dash: repeating-linear-gradient(
      to right,
      var(--stand-black) 0 6px,
      transparent 6px 11px
    );
    background-image: var(--dash), var(--dash);
    background-repeat: no-repeat;
    background-position:
      left top,
      left bottom;
    background-size: 100% 0.5px;
  }

  /* The row block centers within the ruled box; the text inside keeps its
     left justification. fit-content + auto margins do the centering. */
  .weeks .rows {
    width: fit-content;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 14px);
  }

  .week {
    display: grid;
    grid-template-columns: clamp(84px, 8vw, 110px) auto;
    gap: clamp(10px, 1.2vw, 18px);
    align-items: baseline;
  }

  dt {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(12px, 1.1vw, 15px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stand-red);
  }

  dd {
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .para {
    margin-top: clamp(18px, 2vw, 28px);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      padding-left: 20px;
      padding-right: 20px;
    }

    .rail {
      position: static;
    }
  }
</style>
