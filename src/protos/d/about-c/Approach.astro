---
// Our approach — ABOUT C: values-poster layout (JY's Aug 31 reference:
// stacked full-width rows, big display title, small paragraph under it, an
// icon capping the row's right end, hairline rules between). Layout + type
// scale from the reference; style stays STAND — caps-900 titles, red serif
// dek, red rules, and the brand product silhouettes as the icons (CSS mask
// so they all print in one color, like the reference's yellow set).
// Copy is JY's, verbatim (same as accepted A).
const VALUES = [
  {
    name: 'Take ownership',
    dek: 'Learn to take an idea and make it happen.',
    body: [
      'At STAND, kids aren’t following a set of instructions to arrive at the same answer. They’re building something that belongs to them.',
      'That means deciding what needs to happen next, taking responsibility for getting it done, following through, and knowing when to ask for help.',
    ],
    kicker: 'Over time, it’s less “What do I do?” and more “I’ll figure it out.”',
    icon: 'STAND_SVG_YellowLightbulb_Silhouette',
  },
  {
    name: 'Communicate confidently',
    dek: 'Learn to speak up, explain your ideas, and connect with real people.',
    body: [
      'Kids practice talking about what they think, what they’re making, and why it matters.',
      'They ask questions. Listen. Explain. Give and receive feedback. Talk to customers. Present their work. Stand in front of a room and share what they’ve made.',
    ],
    kicker:
      'In a world where so much communication happens through screens, we want kids to get really good at talking to actual people.',
    icon: 'STAND_SVG_YellowMegaphone_Silhouette',
  },
  {
    name: 'Express yourself creatively',
    dek: 'Develop your own ideas, taste, and point of view.',
    body: [
      'Kids get to decide what they like, what they care about, how something should look, what they want to make, and what they want to put into the world.',
      'They draw. Build. Write. Design. Experiment.',
    ],
    kicker: 'They develop a point of view and the confidence to turn it into something real.',
    icon: 'STAND_SVG_PinkPaint_Silhouette',
  },
  {
    // Working name (JY, Aug 31): "Human first" vs "Technology with purpose" —
    // conceptual direction, not final copy.
    name: 'Human first',
    dek: 'Start analog, then bring in the right digital tools.',
    body: [
      'The creative process starts offline: talking, drawing, making, experimenting, researching, and thinking.',
      'Then kids use technology and AI where it makes the work stronger.',
    ],
    kicker:
      'We want them to know how to use powerful tools without handing the entire creative process over to them.',
    icon: 'STAND_SVG_CreamDesk_Silhouette',
  },
  {
    name: 'Problem-solve',
    dek: 'Learn to make decisions, get unstuck, and keep going.',
    body: [
      'Building something real rarely goes exactly according to plan.',
      'Kids learn to test another approach, gather information, ask for help, make a decision, adjust, and move forward.',
    ],
    kicker:
      'There won’t always be someone telling them the right answer. We want them to develop the judgment and resilience to find their own way through.',
    icon: 'STAND_SVG_RedOpenSign_Silhouette',
  },
];
---

<section class="fc-abt-approach" id="about" aria-labelledby="approach-title" data-nav-cream>
  <header class="head">
    <h2 id="approach-title" data-rv style="--rvi: 0">Our approach</h2>
    <p class="frame" data-rv style="--rvi: 1">
      STAND uses entrepreneurship as the vehicle. These are the life skills
      we&rsquo;re actually building.
    </p>
  </header>

  <ul class="rows">
    {
      VALUES.map((v, i) => (
        <li data-rv style={`--rvi: ${i + 2}`}>
          <div class="text">
            <h3>{v.name}</h3>
            <p class="dek">{v.dek}</p>
            {v.body.map((p) => (
              <p class="body">{p}</p>
            ))}
            <p class="body kicker">{v.kicker}</p>
          </div>
          <span
            class="icon"
            style={`--icon: url('/brand/${v.icon}.svg')`}
            aria-hidden="true"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .fc-abt-approach {
    background: var(--stand-cream);
    color: var(--stand-black);
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    /* Opens the page now — top clears the fixed nav. */
    padding: clamp(120px, 13vw, 168px) 48px clamp(56px, 6.1vw, 88px);
  }

  /* Section mark in the Meet Lauren display voice, one step down. */
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(36px, 4.4vw, 64px);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--stand-red);
    text-align: center;
  }

  .frame {
    margin: clamp(14px, 1.6vw, 22px) auto 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(16px, 1.5vw, 21px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    max-width: 44ch;
    text-align: center;
    text-wrap: balance;
  }

  /* The poster list: full-width rows split by hairline red rules — the
     reference's stacked-values board. */
  .rows {
    list-style: none;
    margin: clamp(32px, 3.6vw, 56px) 0 0;
    padding: 0;
  }

  .rows li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 3vw, 48px);
    align-items: start;
    padding: clamp(28px, 3.2vw, 48px) 0;
  }

  /* Full-bleed black rules (JY, Aug 31): the hairline escapes the centered
     column and runs viewport edge to viewport edge. */
  .rows li::after,
  .rows li:first-child::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    background: var(--stand-black);
  }

  .rows li::after {
    bottom: 0;
  }

  .rows li:first-child::before {
    top: 0;
  }

  /* Display-scale title — the reference's poster headline, in STAND's
     value-title voice. */
  h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(30px, 3.9vw, 56px);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .dek {
    margin: clamp(10px, 1.2vw, 18px) 0 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(17px, 1.6vw, 23px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--stand-red);
    text-wrap: pretty;
  }

  .body {
    margin: clamp(10px, 1.1vw, 16px) 0 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.55;
    letter-spacing: -0.005em;
    max-width: 62ch;
    text-wrap: pretty;
  }

  /* Product silhouette as the row's icon — masked box, so the background
     color IS the glyph color (nav-logo trick); one color across the set
     like the reference's yellow icons. */
  .icon {
    display: block;
    width: clamp(48px, 5.5vw, 80px);
    aspect-ratio: 1;
    background: var(--stand-red);
    -webkit-mask: var(--icon) no-repeat center / contain;
    mask: var(--icon) no-repeat center / contain;
  }

  @media (max-width: 768px) {
    .fc-abt-approach {
      padding-left: 20px;
      padding-right: 20px;
    }

    .rows li {
      gap: 16px;
    }

    .icon {
      width: 40px;
    }
  }
</style>
