---
// "The offer" (Figma "HEADER (6)"): cream band, desk-object doodles in the
// corners, centered fact stack, paper-tag signup CTA.
// TODO(asset): the mock has a blue paperclip overlapping the button's left
// edge — not in the export batch yet. Stage as /brand/doodle-paperclip-blue.png
// and add an <img class="doodle clip"> next to .signup.
import SignupButton from './SignupButton.astro';

const FACTS = [
  'Founder’s Class',
  'October 2026',
  '8-week in-person semester',
  'Ages 8 to 13',
  'Westwood, Los Angeles',
];
---

<section class="fc-offer" aria-labelledby="offer-title">
  <img class="doodle scissors" src="/brand/doodle-scissors-mustard.png" alt="" aria-hidden="true" loading="lazy" width="544" height="396" />
  <img class="doodle pencil" src="/brand/doodle-pencil-green.png" alt="" aria-hidden="true" loading="lazy" width="490" height="203" />
  <img class="doodle tie" src="/brand/doodle-tie-red.png" alt="" aria-hidden="true" loading="lazy" width="242" height="460" />
  <img class="doodle bag" src="/brand/doodle-bag-pink.png" alt="" aria-hidden="true" loading="lazy" width="225" height="265" />

  <div class="inner">
    <h2 id="offer-title">the offer</h2>

    <ul class="facts">
      {FACTS.map((f) => <li>{f}</li>)}
    </ul>

    <SignupButton />
  </div>
</section>

<style>
  .fc-offer {
    position: relative;
    background: var(--stand-cream);
    overflow: hidden;
  }

  .doodle {
    position: absolute;
    height: auto;
    pointer-events: none;
  }

  .scissors {
    top: -2%;
    left: -3%;
    width: clamp(180px, 26vw, 380px);
  }

  .pencil {
    top: 8%;
    right: -4%;
    width: clamp(160px, 24vw, 350px);
  }

  .tie {
    bottom: -8%;
    right: 2%;
    width: clamp(90px, 12vw, 170px);
  }

  .bag {
    bottom: 8%;
    left: -2%;
    width: clamp(110px, 15vw, 220px);
  }

  .inner {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(56px, 9vh, 110px) 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.2vw, 32px);
    color: var(--stand-black);
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .facts li {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(26px, 3.2vw, 46px);
    line-height: 1.4;
    color: var(--stand-black);
  }

  @media (max-width: 768px) {
    .inner {
      padding: 48px 20px;
    }

    /* Corner doodles thin out on small screens so they don't crowd the copy. */
    .pencil,
    .bag {
      display: none;
    }
  }
</style>
