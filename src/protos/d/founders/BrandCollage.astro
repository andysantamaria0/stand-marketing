---
// Green brand collage (Figma "HEADER (5)"): pink scribble behind, kid cutouts
// mid-ground, giant postit "stand" wordmark riding the bottom edge in front.
// All children are absolutely positioned against the section's fixed aspect
// ratio so the collage scales as one piece.
// The cap-boy cutout is program-kid.jpg run through Vision subject-lift
// (scratchpad cutout.swift) — different pose than the mock's boy, but the
// only red-STAND-cap shot in the batch.
---

<section class="fc-collage" aria-label="STAND kids">
  <img
    class="scribble"
    src="/brand/scribble-pink.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    width="1163"
    height="857"
  />

  <img
    class="boy"
    src="/brand/cutout-boy-cap.png"
    alt=""
    loading="lazy"
    width="715"
    height="1033"
  />

  <img
    class="pair"
    src="/brand/cutout-kids-dancing.png"
    alt=""
    loading="lazy"
    width="1014"
    height="1039"
  />

  <img
    class="girl"
    src="/brand/cutout-girl-bracelets.png"
    alt="Four STAND kids"
    loading="lazy"
    width="823"
    height="1039"
  />

  <img
    class="wordmark"
    src="/brand/wordmark-postit.png"
    alt="stand"
    loading="lazy"
    width="1372"
    height="326"
  />
</section>

<style>
  .fc-collage {
    position: relative;
    aspect-ratio: 1437 / 1058;
    background: var(--stand-green);
    overflow: hidden;
  }

  .fc-collage img {
    position: absolute;
    height: auto;
  }

  .scribble {
    top: 0;
    left: 6%;
    width: 62%;
    z-index: 1;
  }

  .boy {
    /* Front-left like the mock, tucked behind the postit wordmark. */
    left: -2%;
    bottom: 0;
    width: 45%;
    z-index: 2;
  }

  .pair {
    /* Just right of center, stacked in front of the girl. */
    left: 55%;
    bottom: 6%;
    width: 52%;
    transform: translateX(-50%);
    /* In front of everything — the boys' feet overlap the postit wordmark. */
    z-index: 5;
  }

  .girl {
    left: 35%;
    bottom: 0;
    width: 44%;
    z-index: 2;
  }

  .wordmark {
    left: 2%;
    bottom: -1%;
    width: 96%;
    z-index: 4;
  }
</style>
