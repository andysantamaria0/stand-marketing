---
// Cream-bar nav: red stand wordmark at left (logo.svg as a CSS mask, so the
// background color IS the glyph color), two section links centered, a
// "Sign up" link to /enroll at right. The bar is section-aware: while it
// rides over a cream-ground section it flips to red with a black wordmark
// and white links so it never blends in; over every other ground (video,
// green, photo, pink, red) it stays cream (.is-scrolled, toggled by the
// script at the bottom).
// About is a real page now (Aug 31 review note), so the tabs are a prop:
// the homepage uses the default (page link + local anchor), /proto/d/about
// passes cross-page hrefs and marks itself current.
interface Tab {
  label: string;
  href: string;
  current?: boolean;
}

const {
  tabs = [
    { label: 'About', href: '/proto/d/about' },
    { label: 'Location', href: '#location' },
  ],
} = Astro.props as { tabs?: Tab[] };
---

<nav class="fc-nav" aria-label="Main">
  <div class="brand-cluster">
    <a href="/" class="brand" aria-label="Stand — home">
      <span class="nav-logo"></span>
    </a>

    <!-- Social marks next to the wordmark (Aug 24 review). -->
    <div class="socials">
      <a href="https://www.instagram.com/buildwithstand" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a href="https://www.tiktok.com/@buildwithstand" aria-label="TikTok">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M16 3v3a4 4 0 0 0 4 4v3a7 7 0 0 1-4-1.3V16a5 5 0 1 1-5-5v3a2 2 0 1 0 2 2V3h3z"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="tabs">
    {tabs.map((t) => (
      <a href={t.href} aria-current={t.current ? 'page' : undefined}>
        {t.label}
      </a>
    ))}
  </div>

  <a href="/enroll" class="login">
    <strong>Sign up</strong>
  </a>
</nav>

<style>
  .fc-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 14px 48px;
    background: var(--stand-cream);
    transition: background-color 0.25s ease;
  }

  .fc-nav.is-scrolled {
    background: var(--stand-red);
  }

  /* Center the tabs on the bar itself, not in the leftover flex space —
     otherwise the unequal tag/login widths push them off-axis. */
  .tabs {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 32px;
  }

  .tabs a {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--stand-black);
    transition: color 0.25s ease;
  }

  .is-scrolled .tabs a {
    color: var(--stand-white);
  }

  .tabs a:hover,
  .tabs a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .brand {
    line-height: 0;
  }

  .brand-cluster {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .socials {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .socials a {
    display: grid;
    place-items: center;
    padding: 8px 7px;
    color: var(--stand-black);
    transition: color 0.25s ease;
  }

  .is-scrolled .socials a {
    color: var(--stand-white);
  }

  .socials a:hover {
    color: var(--stand-red);
  }

  .is-scrolled .socials a:hover {
    color: var(--stand-postit);
  }

  /* Masked box: the background paints the wordmark, so recoloring is a
     one-token change. Sized against logo.svg's own viewBox. */
  .nav-logo {
    display: block;
    width: 120px;
    aspect-ratio: 199.29 / 47.33;
    background: var(--stand-red);
    -webkit-mask: url('/brand/logo.svg') no-repeat center / contain;
    mask: url('/brand/logo.svg') no-repeat center / contain;
    transition: background-color 0.25s ease;
  }

  .is-scrolled .nav-logo {
    background: var(--stand-black);
  }

  .login {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: var(--stand-black);
    transition: color 0.25s ease;
  }

  .is-scrolled .login {
    color: var(--stand-white);
  }

  .login strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 900;
    margin-left: 4px;
  }

  @media (max-width: 1024px) {
    .tabs {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .fc-nav {
      padding: 10px 20px;
    }

    .nav-logo {
      width: 90px;
    }

    .login {
      font-size: 12px;
    }

    /* Phones: the icon cluster crowds the 90px logo — socials live in the
       footer there anyway. */
    .socials {
      display: none;
    }
  }
</style>

<script>
  // Flip the bar to its red state only while it overlaps a cream-ground
  // section; everywhere else it stays cream. Measured per scroll event
  // (Lenis eases the native scroll position, so this fires on the same rAF
  // cadence as the smoothing) — four getBoundingClientRect calls per frame
  // is well under a millisecond.
  const nav = document.querySelector<HTMLElement>('.fc-nav');
  const creamSections = document.querySelectorAll(
    '.fc-newspace, .fc-location, .fc-faq, [data-nav-cream]',
  );
  const onScroll = () => {
    if (!nav) return;
    const probe = nav.offsetHeight;
    let overCream = false;
    creamSections.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top <= probe && r.bottom > probe) overCream = true;
    });
    nav.classList.toggle('is-scrolled', overCream);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
</script>
