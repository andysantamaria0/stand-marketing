---
// PROTO — general-interest email bar in the footer (JY, Aug 25), replacing
// the "Sign up now" sticker in Closing. Reference: underlined input row, big
// quiet placeholder, display-type "Sign up →" at the right. Colors ride on
// currentColor so the bar inherits the closing band's cream-on-red.
//
// VISUAL MOCK ONLY: submit validates and shows the success state locally —
// no email is saved. The wired version (fetch to the pending
// POST /api/subscribe contract) lives at components/founders/SubscribeBar.astro;
// swap behavior there when the endpoint exists.
---

<div class="subwrap">
  <form class="subscribe" id="proto-updates-form" novalidate aria-label="Sign up for updates">
    <div class="row">
      <label class="sr-only" for="proto-updates-email">Your email</label>
      <input
        id="proto-updates-email"
        name="email"
        type="email"
        placeholder="enter your email"
        autocomplete="email"
        required
      />
      <button type="submit" class="go">
        Sign up<span class="arrow" aria-hidden="true">&rarr;</span>
      </button>
    </div>
    <p class="note" id="proto-updates-error" role="alert" hidden></p>
  </form>
  <p class="done" id="proto-updates-done" role="status" hidden></p>
</div>

<style>
  .subwrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .subscribe {
    width: min(720px, 100%);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Input and button share one 2px rule so the row reads as a single drawn
     line, not a boxed field. currentColor = the band's cream. */
  .row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    border-bottom: 2px solid currentColor;
    padding-bottom: 10px;
  }

  .row:focus-within {
    /* Focus the brand way: the rule underlines in post-it yellow (green
       vanishes on the red band). Shadow, not border, so height is stable. */
    box-shadow: 0 3px 0 0 var(--stand-postit);
  }

  .subscribe input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    /* A notch under the old clamp(20px, 2.6vw, 34px) — at full size the
       input dwarfed the 22px Pie Pie "Sign up" (JY, Aug 25). */
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.3;
    color: currentColor;
    text-align: left;
  }

  .subscribe input::placeholder {
    color: color-mix(in srgb, currentColor 45%, transparent);
  }

  .subscribe input:focus {
    outline: none; /* the row's yellow rule is the focus indicator */
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    background: none;
    padding: 0 0 2px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.04em;
    color: currentColor;
    cursor: pointer;
    white-space: nowrap;
  }

  .go .arrow {
    transition: transform 150ms ease-out;
  }

  .go:hover .arrow {
    transform: translateX(4px);
  }

  .go:focus-visible {
    outline: 3px solid var(--stand-postit);
    outline-offset: 4px;
  }

  .note {
    margin: 10px 0 0;
    font-family: var(--font-sans);
    font-size: 15px;
    text-align: left;
    color: var(--stand-postit);
  }

  .done {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 28px);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .row {
      gap: 12px;
    }

    .go {
      font-size: 18px;
    }
  }
</style>

<script>
  // Mock submit: validate, then show the success line. No network — this is
  // the design-lab surface; the wired fetch lives in components/founders.
  const form = document.getElementById('proto-updates-form') as HTMLFormElement | null;
  const input = document.getElementById('proto-updates-email') as HTMLInputElement | null;
  const errorEl = document.getElementById('proto-updates-error');
  const doneEl = document.getElementById('proto-updates-done');

  const looksLikeEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;

    if (errorEl) errorEl.hidden = true;
    if (!looksLikeEmail(input.value.trim())) {
      if (errorEl) {
        errorEl.textContent = 'Enter a valid email address.';
        errorEl.hidden = false;
      }
      input.focus();
      return;
    }

    form.hidden = true;
    if (doneEl) {
      doneEl.textContent = "Good, you're on the list!";
      doneEl.hidden = false;
    }
  });
</script>
