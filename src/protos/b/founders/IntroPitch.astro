---
// Yellow intro statement (Figma "HEADER"): post-it ground with the mustard
// scribble vector bleeding off the right edge, statement headline, serif
// sub-copy, and a centered paper-tag "sign up now" CTA.
import SignupButton from './SignupButton.astro';
---

<section class="fc-intro" aria-labelledby="intro-title">
  <img
    class="scribble"
    src="/brand/scribble-yellow.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    width="807"
    height="520"
  />

  <div class="inner">
    <h2 id="intro-title">
      STAND is the in-person entrepreneurship program where kids build their
      own business, from idea to first sale.
    </h2>

    <p class="sub">
      Join our pilot program in Los Angeles. A real space, with real teachers.
      Analog first, then digital: kids make things with their hands, then use
      the best tools out there to take them live. It is a companion to the
      technology kids already live in, built to make them more capable in it.
    </p>

    <SignupButton />
  </div>
</section>

<style>
  .fc-intro {
    position: relative;
    background: var(--stand-postit);
    overflow: hidden;
  }

  .scribble {
    position: absolute;
    top: 0;
    right: -12%;
    height: 100%;
    width: auto;
    pointer-events: none;
  }

  .inner {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(56px, 8vh, 96px) 48px clamp(48px, 7vh, 80px);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(30px, 4vw, 58px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--stand-black);
  }

  .sub {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(17px, 1.5vw, 22px);
    line-height: 1.3;
    color: var(--stand-black);
  }

  @media (max-width: 768px) {
    .inner {
      padding: 48px 20px;
    }
  }
</style>
