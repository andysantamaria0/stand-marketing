---
// PROTO B footer email capture (JY's Aug 25 screenshot): the sticker
// language as a form — a big skewed white face with a hard ink shadow,
// Pie Pie email input inside, serif underlined "Sign Up →" at the right.
// Compare against A's quiet underline bar.
//
// VISUAL MOCK ONLY: validates and shows the success line locally — no email
// is saved. The wired fetch (pending POST /api/subscribe) lives at
// components/founders/SubscribeBar.astro.
---

<div class="stickerwrap">
  <form class="sticker" id="protob-updates-form" novalidate aria-label="Sign up for updates">
    <label class="sr-only" for="protob-updates-email">Your email</label>
    <input
      id="protob-updates-email"
      name="email"
      type="email"
      placeholder="enter your email"
      autocomplete="email"
      required
    />
    <button type="submit" class="go">Sign Up <span aria-hidden="true">&rarr;</span></button>
  </form>
  <p class="note" id="protob-updates-error" role="alert" hidden></p>
  <p class="done" id="protob-updates-done" role="status" hidden></p>
</div>

<style>
  .stickerwrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The white face is a ::before layer (the SignupButton recipe). Straight,
     no tilt (JY, Aug 25) — the hard ink shadow alone does the sticker read. */
  .sticker {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
    width: min(880px, 100%);
    min-height: clamp(76px, 8.5vw, 118px);
    padding: 10px clamp(24px, 4.5vw, 64px);
  }

  .sticker::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--stand-white);
    border: 2px solid var(--stand-black);
    box-shadow: 9px 9px 0 var(--stand-black);
  }

  .sticker input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0;
    /* Pie Pie at poster scale — the reference's hello@standkids.com weight. */
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 3.2vw, 42px);
    letter-spacing: 0.01em;
    color: var(--stand-black);
    text-align: left;
  }

  .sticker input::placeholder {
    color: color-mix(in srgb, var(--stand-black) 45%, transparent);
  }

  .sticker input:focus {
    outline: none; /* the face's shadow-lift below is the focus signal */
  }

  /* Focus lifts the sticker the same way the buttons hover. */
  .sticker:focus-within::before {
    box-shadow: 12px 12px 0 var(--stand-black);
  }

  /* Serif "Sign Up →" — Editorial New, underlined, quietly small against
     the giant Pie Pie input (per the reference). */
  .go {
    border: 0;
    background: none;
    padding: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(17px, 1.7vw, 24px);
    color: var(--stand-black);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    white-space: nowrap;
  }

  .go:hover {
    text-decoration-thickness: 2px;
  }

  .go:focus-visible {
    outline: 3px solid var(--stand-black);
    outline-offset: 4px;
  }

  /* Feedback rides on the band below the sticker (cream/red ground). */
  .note {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--stand-postit);
  }

  .done {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 28px);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .sticker {
      gap: 14px;
      padding: 10px 18px;
      min-height: 64px;
    }

    .sticker::before {
      box-shadow: 6px 6px 0 var(--stand-black);
    }
  }
</style>

<script>
  // Mock submit: validate, then show the success line. No network — this is
  // the design-lab surface; the wired fetch lives in components/founders.
  const form = document.getElementById('protob-updates-form') as HTMLFormElement | null;
  const input = document.getElementById('protob-updates-email') as HTMLInputElement | null;
  const errorEl = document.getElementById('protob-updates-error');
  const doneEl = document.getElementById('protob-updates-done');

  const looksLikeEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;

    if (errorEl) errorEl.hidden = true;
    if (!looksLikeEmail(input.value.trim())) {
      if (errorEl) {
        errorEl.textContent = 'Enter a valid email address.';
        errorEl.hidden = false;
      }
      input.focus();
      return;
    }

    form.hidden = true;
    if (doneEl) {
      doneEl.textContent = "Good, you're on the list!";
      doneEl.hidden = false;
    }
  });
</script>
