---
// Meet Lauren — PROTO B: "split panel" (Aug 28 reference: We Butter Both
// Sides layout — left text stack with a chunky display headline + inline
// doodle, caps accent subline, two small paragraphs and a small CTA; right
// half is one full-bleed photo running edge to edge). Layout and type scale
// follow the reference; the styling stays STAND (heavy sans in red, cream
// panel, brand prop inline). Bio facts supplied by JY (Aug 28); the
// business-school line is lifted from the one-pager's approved copy.
import SignupButton from './SignupButton.astro';
---

<section class="fc-lauren-b" id="meet-lauren" aria-labelledby="lauren-title-b">
  <div class="panel">
    <h2 id="lauren-title-b" data-rv style="--rvi: 0">
      Meet
      <span class="line2">Lauren</span>
    </h2>

    <p class="body" data-rv style="--rvi: 1">
      Before STAND, Lauren co-founded The Wing, a groundbreaking membership
      network built across women-focused workspaces. She led business
      development at ClassPass and was the first employee at the fitness brand
      SLT &mdash; a career of building consumer businesses and
      community-driven platforms from zero to scale.
    </p>

    <div class="cta" data-rv style="--rvi: 2">
      <SignupButton label="Get first access" />
    </div>
  </div>

  <img
    class="photo"
    src="/brand/lauren.webp"
    alt="Lauren, founder and CEO of STAND, in front of a bookshelf"
    loading="lazy"
    width="1280"
    height="720"
  />
</section>

<style>
  .fc-lauren-b {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(48px, 5.5vw, 88px) clamp(32px, 4vw, 64px)
      clamp(48px, 5.5vw, 88px) clamp(24px, 4.5vw, 72px);
    max-width: 640px;
    justify-self: end;
    width: 100%;
  }

  /* Chunky two-line display headline. */
  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(48px, 5.4vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--stand-red);
  }

  .line2 {
    display: block;
  }

  /* The reference's small dense paragraphs — a full step down from the
     page's usual body size. */
  .body {
    margin: clamp(18px, 2vw, 28px) 0 0;
    max-width: 48ch;
    font-family: var(--font-sans);
    font-weight: 400;
    /* Same size as the Location week-table rows. */
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .cta {
    margin-top: clamp(22px, 2.4vw, 34px);
  }

  .cta :global(.signup) {
    min-width: 0;
  }

  /* Full-bleed photo: fills the right half to the section edges and sets
     the section's height — the panel centers against it. */
  .photo {
    width: 100%;
    height: 100%;
    min-height: 480px;
    object-fit: cover;
    /* Keep Lauren (just left of frame center) and her face in the crop. */
    object-position: 47% 20%;
  }

  @media (max-width: 900px) {
    .fc-lauren-b {
      grid-template-columns: 1fr;
    }

    .panel {
      max-width: none;
      justify-self: stretch;
      padding: 48px 20px;
    }

    .photo {
      min-height: 0;
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }
</style>
