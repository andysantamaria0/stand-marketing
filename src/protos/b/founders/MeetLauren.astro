---
// Meet Lauren — PROTO B: "pull-quote billboard". Full-bleed red band between
// the cream Location and the green WalkAway collage. The approved
// business-school line runs huge in Editorial New Light cream, signed as
// Lauren; a tilted polaroid portrait + short credentials row sit beneath.
// Bio facts supplied by JY (Aug 28).
---

<section class="fc-lauren-b" id="meet-lauren" aria-labelledby="lauren-title-b">
  <div class="inner">
    <p class="eyebrow" data-rv style="--rvi: 0">Meet Lauren &mdash; Founder &amp; CEO</p>

    <blockquote class="quote" data-rv style="--rvi: 1">
      <p id="lauren-title-b">
        &ldquo;I didn&rsquo;t go to business school.
        <span class="line2">I just did business.&rdquo;</span>
      </p>
    </blockquote>

    <div class="row">
      <!-- TODO(asset): portrait → /brand/lauren.webp -->
      <figure class="polaroid" data-rv style="--rvi: 2">
        <div class="photo frame-ph">
          <span>&lt;Portrait &mdash; Lauren&gt;</span>
        </div>
        <figcaption>Lauren, in the room every weekday cohort</figcaption>
      </figure>

      <div class="bio" data-rv style="--rvi: 3">
        <p>
          Before STAND, Lauren co-founded The Wing, the groundbreaking
          membership network built across women-focused workspaces. She led
          business development at ClassPass and was the first employee at the
          fitness brand SLT &mdash; a career of building consumer businesses
          from zero to scale.
        </p>
        <p class="honors">
          Forbes 30 Under 30 &nbsp;&middot;&nbsp; Fast Company 100 Most
          Creative People in Business &nbsp;&middot;&nbsp; Goldman Sachs 100
          Most Intriguing Entrepreneurs
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .fc-lauren-b {
    background: var(--stand-red);
    color: var(--stand-cream);
  }

  .inner {
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 6.1vw, 88px) 48px clamp(56px, 6.3vw, 90px);
  }

  .eyebrow {
    margin: 0 0 clamp(20px, 2.2vw, 32px);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(12px, 1.1vw, 15px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .quote {
    margin: 0;
  }

  .quote p {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(38px, 5.4vw, 80px);
    line-height: 1.06;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Second line steps in — the mast-head stagger the About mega uses. */
  .line2 {
    display: block;
    padding-left: clamp(32px, 8vw, 128px);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(32px, 4.5vw, 64px);
    align-items: center;
    margin-top: clamp(36px, 4.2vw, 64px);
  }

  /* Polaroid: cream mat, tilted like the testimonial deck cards. */
  .polaroid {
    margin: 0;
    justify-self: start;
    width: min(100%, 300px);
    padding: 10px 10px 14px;
    background: var(--stand-cream);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
    transform: rotate(-3deg);
  }

  .photo {
    aspect-ratio: 3 / 4;
  }

  .frame-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    border: 2px dashed rgba(0, 0, 0, 0.35);
    background: rgba(0, 0, 0, 0.04);
    color: var(--stand-black);
  }

  .frame-ph span {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 16px;
    opacity: 0.65;
  }

  .polaroid figcaption {
    margin-top: 10px;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 14px;
    line-height: 1.3;
    color: var(--stand-black);
    text-align: center;
  }

  .bio p {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .bio .honors {
    margin-top: clamp(16px, 1.8vw, 26px);
    font-size: clamp(13px, 1.2vw, 16px);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  @media (max-width: 900px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .polaroid {
      justify-self: center;
      transform: rotate(-2deg);
    }
  }
</style>
