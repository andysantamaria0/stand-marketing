---
// Pink kid collage (Figma frame "4") — hot-pink band, kid cutouts bleeding
// off the top and side edges. Replaces the blue/green striped "what a kid
// walks away with" section; the copy was cut per the Aug 19 review, leaving
// the collage as a purely visual beat. Cutouts are positioned in % of the
// fixed-aspect .kids frame (same technique as BrandCollage) so the collage
// scales as one piece.
---

<section class="fc-walkaway" aria-label="STAND kids">
  <div class="kids" aria-hidden="true">
    <img
      class="boy"
      style="--drift: 40px"
      src="/brand/cutout-boy-tote.png"
      alt=""
      loading="lazy"
      width="579"
      height="1022"
    />
    <img
      class="girl"
      style="--drift: 90px"
      src="/brand/cutout-girl-bracelets.png"
      alt=""
      loading="lazy"
      width="823"
      height="1039"
    />
    <img
      class="poloboy"
      style="--drift: 110px"
      src="/brand/cutout-boy-football.png"
      alt=""
      loading="lazy"
      width="887"
      height="1108"
    />
  <!-- Outside .kids on purpose: the frame clips at the section edge, but
       his sneaker should ride ON the seam — he overhangs into the next
       section instead of being cut by it. -->
  <img
    class="seatedboy"
    style="--drift: 140px"
    src="/brand/cutout-boy-seated.png"
    alt=""
    loading="lazy"
    width="887"
    height="1108"
  />
</section>

<style>
  .fc-walkaway {
    position: relative;
    background: var(--stand-pink);
  }

  /* Shorter than the comp's 1437×1022 frame — with the copy cut, the band
     ends just under the cutouts instead of trailing empty pink. */
  .kids {
    position: relative;
    aspect-ratio: 1437 / 860;
    overflow: hidden;
  }

  .kids img {
    position: absolute;
    height: auto;
  }

  /* Scroll-scrubbed drift — each kid settles at a different speed as the
     band scrolls in (view-timeline; reverses on scroll-up). Browsers
     without support render static. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .kids img,
      .seatedboy {
        animation: fc-wa-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes fc-wa-drift {
    from {
      transform: translateY(var(--drift, 60px));
    }

    to {
      transform: none;
    }
  }

  .boy {
    left: -4%;
    top: -3%;
    width: 42%;
  }

  .girl {
    left: 38%;
    top: 4%;
    width: 52%;
  }

  .seatedboy {
    position: absolute;
    left: 21%;
    /* Overhangs the section seam so the sneaker sits ON the border. */
    bottom: -20%;
    width: 51%;
    height: auto;
    z-index: 2;
  }

  .poloboy {
    left: 70%;
    top: auto;
    bottom: 0;
    width: 34%;
  }
</style>
