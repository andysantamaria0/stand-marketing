---
// Location — Proto C: single column (Aug 24 review; B keeps the split rail).
// Pie Pie West-LA announcement, the program beats stacked under it, CTA last.
// Copy per the Aug 24 web-copy doc.
// Chunks use the page-level data-rv reveal (armed by the index script).
import SignupButton from './SignupButton.astro';
---

<section class="fc-location" id="location" aria-labelledby="location-title">
  <div class="inner">
    <h2 id="location-title" data-rv style="--rvi: 0">
      This fall, we&rsquo;re opening our first STAND location in West&nbsp;<span class="keep-case">LA</span>!
    </h2>

    <div class="beats" data-rv style="--rvi: 1">
      <p>For eight weeks, kids ages 8&ndash;13 will take an idea and build it into a real business.</p>
      <p>
        They can come in knowing what they want to make. Or with no idea at
        all. They build a brand, a product, a plan and a pitch they deliver
        in front of a room at the end of the semester.
      </p>
      <p>
        They&rsquo;ll meet in person and move through the full process of
        taking an idea and turning it into a real business &mdash; with
        hands-on mentorship, a community of other kids building alongside
        them, and digital tools that support them along the way.
      </p>
    </div>

    <div class="cta" data-rv style="--rvi: 2">
      <SignupButton label="get first access" />
    </div>
  </div>
</section>

<style>
  .fc-location {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 2.6vw, 40px);
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 6.1vw, 88px) 48px clamp(56px, 6.3vw, 90px);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.04;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  /* "LA" stays caps inside the lowercased Pie Pie headline. */
  h2 .keep-case {
    text-transform: none;
  }

  .beats {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.5vw, 22px);
    /* Reading measure — full 1132px lines are too long for body copy. */
    max-width: 62ch;
  }

  .beats p {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .cta {
    margin-top: clamp(8px, 1vw, 16px);
  }

  .cta :global(.signup) {
    min-width: 0;
    align-self: flex-start;
  }

  @media (max-width: 768px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
