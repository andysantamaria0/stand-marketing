---
// Location option 1 — "zine grid" (Aug 24 review): 50/50 split with a thick
// vertical rule, the three beats chunked into ruled rows with bold red
// micro-headers, and a heavier tactile shadow on the CTA.
import SignupButton from './SignupButton.astro';

const ROWS = [
  {
    n: '01',
    label: 'The Mission',
    text: 'For eight weeks, kids ages 8–13 will take an idea and build it into a real business.',
  },
  {
    n: '02',
    label: 'The Idea',
    text: 'They can come in knowing what they want to make. Or with no idea at all. They build a brand, a product, a plan and a pitch they deliver in front of a room at the end of the semester.',
  },
  {
    n: '03',
    label: 'The Process',
    text: 'They’ll meet in person and move through the full process of taking an idea and turning it into a real business — with hands-on mentorship, a community of other kids building alongside them, and digital tools that support them along the way.',
  },
];
---

<section class="loc-zine" aria-labelledby="zine-title">
  <div class="grid">
    <header class="rail">
      <h2 id="zine-title">
        This fall, we&rsquo;re opening our first STAND location in West&nbsp;<span class="keep-case">LA</span>!
      </h2>
      <div class="cta">
        <SignupButton label="get first access" />
      </div>
    </header>

    <div class="rows">
      {
        ROWS.map((r) => (
          <div class="row">
            <p class="micro">{r.n}. {r.label}</p>
            <p class="text">{r.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .loc-zine {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 6.1vw, 88px) 48px clamp(56px, 6.3vw, 90px);
  }

  .rail {
    position: sticky;
    top: 96px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.2vw, 32px);
    padding-right: clamp(28px, 3.2vw, 48px);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.04;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  h2 .keep-case {
    text-transform: none;
  }

  /* Heavy, clicky sticker — the shadow goes deep and stays solid black. */
  .cta :global(.signup) {
    min-width: 0;
    align-self: flex-start;
  }

  .cta :global(.signup)::before {
    box-shadow: 10px 10px 0 var(--stand-black);
  }

  /* The zine spine: thick rule dividing header from body. */
  .rows {
    border-left: 3px solid var(--stand-black);
    padding-left: clamp(28px, 3.2vw, 48px);
    display: flex;
    flex-direction: column;
  }

  .row {
    padding: clamp(20px, 2.2vw, 30px) 0;
    border-bottom: 2px solid var(--stand-black);
  }

  .row:first-child {
    padding-top: 0;
  }

  .row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .micro {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stand-red);
  }

  .text {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      row-gap: 32px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .rail {
      position: static;
      padding-right: 0;
    }

    .rows {
      border-left: 0;
      border-top: 3px solid var(--stand-black);
      padding-left: 0;
      padding-top: 24px;
    }
  }
</style>
