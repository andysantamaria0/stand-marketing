---
// Meet Lauren — PROTO C: "scroll split + word reveal" (JY, Aug 28 eve).
// Masthead + centered quote, then a pinned stage: the long-oval portrait
// starts centered; at the halfway point of the runway it glides left and the
// bio — Authentic Sans, per JY — appears on the right word by word as the
// reader keeps scrolling (each word's opacity trips at its own progress
// threshold). The business-school line is the one-pager's approved copy.
const BIO =
  'Before STAND, Lauren co-founded The Wing, a groundbreaking membership ' +
  'network built across women-focused workspaces. She led business ' +
  'development at ClassPass and was the first employee at the fitness brand ' +
  'SLT — a career of building consumer businesses and community-driven ' +
  'platforms from zero to scale.';
const WORDS = BIO.split(' ');
---

<section class="fc-lauren" id="meet-lauren" aria-labelledby="lauren-title">
  <div class="inner">
    <header class="masthead">
      <h2 id="lauren-title" data-rv style="--rvi: 0">Meet Lauren</h2>
    </header>

    <p class="statement" data-rv style="--rvi: 1">
      &ldquo;I didn&rsquo;t go to business school.
      <em>I just did business.&rdquo;</em>
    </p>
  </div>

  <div class="scrolly" data-lauren-scrolly>
    <div class="stage">
      <img
        class="photo"
        src="/brand/lauren.webp"
        alt="Lauren, founder and CEO of STAND, in front of a bookshelf"
        loading="lazy"
        width="1280"
        height="720"
      />

      <p class="bio">
        {WORDS.map((w) => <span class="w">{w} </span>)}
      </p>
    </div>
  </div>
</section>

<style>
  .fc-lauren {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .inner {
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(40px, 4.5vw, 64px) 48px 0;
  }

  .masthead {
    text-align: center;
  }

  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(56px, 8.2vw, 120px);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .statement {
    margin: clamp(16px, 1.8vw, 28px) auto 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
  }

  .statement em {
    font-style: normal;
    color: var(--stand-red);
  }

  /* Scroll runway: the extra viewports of height are what the reader scrolls
     through while the sticky stage plays the swap, then the word reveal. */
  .scrolly {
    height: 280vh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  /* The oval portrait: starts dead center, glides to the left quarter once
     .split lands. left+transform both transition so the glide is one move. */
  .photo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(56vw, 340px);
    height: auto;
    aspect-ratio: 3 / 5;
    object-fit: cover;
    /* Keep Lauren (just left of frame center) and her face in the crop. */
    object-position: 47% 20%;
    border-radius: 50%;
    transition:
      left 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bio {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(24px, -50%);
    margin: 0;
    max-width: min(44vw, 30ch);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(20px, 2.4vw, 38px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: pretty;
    opacity: 0;
    transition:
      opacity 0.5s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Word reveal: every word sits at a whisper until the scroll progress
     trips its threshold (JS adds .on). */
  .bio .w {
    opacity: 0.12;
    transition: opacity 0.3s ease;
  }

  .bio .w.on {
    opacity: 1;
  }

  .stage.split .photo {
    left: 26%;
  }

  .stage.split .bio {
    opacity: 1;
    transform: translate(0, -50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo,
    .bio,
    .bio .w {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .photo {
      width: min(52vw, 250px);
    }

    .stage.split .photo {
      left: 27%;
    }

    .bio {
      left: 48%;
      max-width: 48vw;
      font-size: clamp(14px, 2.4vw, 20px);
    }
  }
</style>

<script>
  // Scroll-driven stage: past ~half the runway the photo glides left and the
  // bio pane fades in; the remaining runway feeds the word-by-word reveal.
  // rAF-throttled — scroll events outpace frames, so sample once per paint.
  const scrolly = document.querySelector<HTMLElement>('[data-lauren-scrolly]');
  const stage = scrolly?.querySelector<HTMLElement>('.stage');
  const words = stage ? [...stage.querySelectorAll<HTMLElement>('.bio .w')] : [];

  if (scrolly && stage) {
    const SPLIT_AT = 0.45; // photo starts its glide just before halfway
    const WORDS_FROM = 0.5; // word reveal rides the back half of the runway
    const WORDS_TO = 0.95;
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = scrolly.getBoundingClientRect();
      const runway = rect.height - window.innerHeight;
      const progress = runway > 0 ? -rect.top / runway : 1;

      stage.classList.toggle('split', progress >= SPLIT_AT);

      const t = (progress - WORDS_FROM) / (WORDS_TO - WORDS_FROM);
      const lit = Math.floor(Math.min(Math.max(t, 0), 1) * words.length);
      words.forEach((w, i) => w.classList.toggle('on', i < lit));
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
