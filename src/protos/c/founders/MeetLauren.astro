---
// Meet Lauren — PROTO C: "billboard quote" (Aug 28 reference: Meet Emonee
// layout — giant centered display headline, then one oversized centered
// quote spanning the width; no photo in the frame). Layout and type scale
// follow the reference; the styling stays STAND (heavy sans masthead,
// Editorial New quote, cream/red). The business-school line is lifted from
// the one-pager's approved copy; credentials compress to one caps line.
---

<section class="fc-lauren-c" id="meet-lauren" aria-labelledby="lauren-title-c">
  <div class="inner">
    <h2 id="lauren-title-c" data-rv style="--rvi: 0">
      Meet
      <span class="line2">Lauren!</span>
    </h2>

    <blockquote class="quote" data-rv style="--rvi: 1">
      <p>
        &ldquo;I didn&rsquo;t go to business school.
        I&nbsp;just did business.&rdquo;
      </p>
    </blockquote>

    <img
      class="portrait"
      src="/brand/lauren.webp"
      alt="Lauren, founder and CEO of STAND, in front of a bookshelf"
      loading="lazy"
      width="1280"
      height="720"
      data-rv
      style="--rvi: 2"
    />
  </div>
</section>

<style>
  .fc-lauren-c {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .inner {
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(48px, 5.5vw, 88px) 48px clamp(56px, 6.3vw, 90px);
    text-align: center;
  }

  /* Giant two-line masthead — the reference's chunky centered display. */
  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(56px, 9vw, 140px);
    line-height: 0.94;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--stand-red);
  }

  .line2 {
    display: block;
  }

  /* One oversized centered quote carrying the whole section. */
  .quote {
    margin: clamp(32px, 3.8vw, 56px) auto 0;
  }

  .quote p {
    /* ch here resolves against the quote's own display size — on the
       blockquote it inherits the 16px base and collapses to ~220px. */
    max-width: 22ch;
    margin: 0 auto;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(34px, 4.6vw, 68px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Centered matted print under the quote — same straight treatment as A. */
  .portrait {
    display: block;
    width: min(100%, 620px);
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    /* Keep Lauren (just left of frame center) and her face in the crop. */
    object-position: 47% 20%;
    margin: clamp(32px, 3.8vw, 56px) auto 0;
    border: 10px solid var(--stand-cream);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.16);
  }

  @media (max-width: 900px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
