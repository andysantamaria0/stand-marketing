---
// Meet Lauren — PROTO C: A's masthead profile, diverged (JY, Aug 28 eve):
// the portrait crops to a long oval, and the bio sentence leaves the column
// to become its own full-height screen set at the NewSpace mega size
// ("A Modern Day Lemonade Stand" — Editorial New Light, clamp 24/5.2vw/75).
// Two <section>s so each screen arms its own chunk-reveal observer.
// The business-school line is lifted from the one-pager's approved copy.
---

<section class="fc-lauren" id="meet-lauren" aria-labelledby="lauren-title">
  <div class="inner">
    <header class="masthead">
      <h2 id="lauren-title" data-rv style="--rvi: 0">Meet Lauren</h2>
    </header>

    <div class="cols">
      <figure class="figure" data-rv style="--rvi: 1">
        <img
          class="photo"
          src="/brand/lauren.webp"
          alt="Lauren, founder and CEO of STAND, in front of a bookshelf"
          loading="lazy"
          width="1280"
          height="720"
        />
      </figure>

      <div class="copy">
        <p class="statement" data-rv style="--rvi: 2">
          &ldquo;I didn&rsquo;t go to business school.
          <em>I just did business.&rdquo;</em>
        </p>
      </div>
    </div>
  </div>
</section>

<section class="fc-lauren-bio" aria-label="About Lauren">
  <p class="bio" data-rv style="--rvi: 0">
    Before STAND, Lauren co-founded The Wing, a groundbreaking membership
    network built across women-focused workspaces. She led business
    development at ClassPass and was the first employee at the fitness brand
    SLT &mdash; a career of building consumer businesses and community-driven
    platforms from zero to scale.
  </p>
</section>

<style>
  .fc-lauren {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .inner {
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(40px, 4.5vw, 64px) 48px clamp(56px, 6.3vw, 90px);
  }

  .masthead {
    text-align: center;
  }

  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(56px, 8.2vw, 120px);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(36px, 4.5vw, 64px);
    align-items: center;
    margin-top: clamp(36px, 4.2vw, 64px);
  }

  .figure {
    position: relative;
    justify-self: center;
    width: min(100%, 380px);
    margin: 0;
  }

  /* Long oval crop — tall ellipse, the editorial arch. */
  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 5;
    object-fit: cover;
    /* Keep Lauren (just left of frame center) and her face in the crop. */
    object-position: 47% 20%;
    border-radius: 50%;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .statement {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .statement em {
    font-style: normal;
    color: var(--stand-red);
  }

  /* The bio takes its own screen, set at the NewSpace mega size. */
  .fc-lauren-bio {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(520px, 92vh, 920px);
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .bio {
    margin: 0;
    max-width: calc(1132px + 2 * 48px);
    padding: clamp(48px, 5.5vw, 88px) 48px;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(24px, 5.2vw, 75px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .figure {
      width: min(70%, 300px);
    }

    .bio {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
