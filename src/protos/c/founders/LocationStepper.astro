---
// Location option 3 — "centered hero + stepper" (Aug 24 review): the West-LA
// announcement centered as a hero statement with the CTA right under it, then
// the three beats as a 3-column step flow headed by tactile numbered dials.
import SignupButton from './SignupButton.astro';

const STEPS = [
  'For eight weeks, kids ages 8–13 will take an idea and build it into a real business.',
  'They can come in knowing what they want to make. Or with no idea at all. They build a brand, a product, a plan and a pitch they deliver in front of a room at the end of the semester.',
  'They’ll meet in person and move through the full process of taking an idea and turning it into a real business — with hands-on mentorship, a community of other kids building alongside them, and digital tools that support them along the way.',
];
---

<section class="loc-stepper" aria-labelledby="stepper-title">
  <div class="inner">
    <h2 id="stepper-title">
      This fall, we&rsquo;re opening our first STAND location in West&nbsp;<span class="keep-case">LA</span>!
    </h2>

    <div class="cta">
      <SignupButton label="get first access" />
    </div>

    <ol class="steps">
      {
        STEPS.map((text, i) => (
          <li class="step">
            <span class="dial" aria-hidden="true">{i + 1}</span>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .loc-stepper {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(24px, 2.6vw, 40px);
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 6.1vw, 88px) 48px clamp(56px, 6.3vw, 90px);
  }

  h2 {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 4.2vw, 60px);
    line-height: 1.04;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  h2 .keep-case {
    text-transform: none;
  }

  .cta :global(.signup) {
    min-width: 0;
  }

  .steps {
    list-style: none;
    margin: clamp(16px, 1.8vw, 28px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3.4vw, 52px);
    align-self: stretch;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 1.5vw, 20px);
  }

  /* Tactile hardware dial: raised white disc, hard black lift, Pie Pie
     numeral — reads as "press 1, then 2, then 3". */
  .dial {
    display: grid;
    place-items: center;
    width: clamp(52px, 4.4vw, 64px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--stand-white);
    border: 2px solid var(--stand-black);
    box-shadow: 4px 4px 0 var(--stand-black);
    font-family: var(--font-display);
    font-size: clamp(20px, 1.8vw, 26px);
  }

  .step p {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  @media (max-width: 768px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
