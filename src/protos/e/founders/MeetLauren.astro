---
// Meet Lauren — PROTO E: "zine spread" (Aug 28 reference: night-drives zine
// page — full-bleed photo edge to edge, giant chunky headline split between
// the top-left and bottom-left of the frame, small black caption card
// bottom-right). Layout follows the reference; styling stays STAND (heavy
// sans in post-it yellow over the dimmed photo, black caption card).
// The approved business-school line splits across the two headline rows.
---

<section class="fc-lauren-e" id="meet-lauren" aria-labelledby="lauren-title-e">
  <img
    class="photo"
    src="/brand/lauren.webp"
    alt="Lauren, founder and CEO of STAND, in front of a bookshelf"
    loading="lazy"
    width="1280"
    height="720"
  />

  <h2 id="lauren-title-e">
    <span class="top" data-rv style="--rvi: 0">
      &ldquo;I didn&rsquo;t go to business&nbsp;school.
    </span>
    <span class="bottom" data-rv style="--rvi: 1">
      I just did business.&rdquo;
    </span>
  </h2>

  <p class="card" data-rv style="--rvi: 2">
    Meet Lauren &mdash; founder &amp; CEO of STAND. Co-founded The Wing, led
    business development at ClassPass, employee #1 at SLT. Forbes 30 Under
    30 &middot; Fast Company 100 Most Creative &middot; Goldman Sachs 100
    Most Intriguing.
    <span class="tag">*and she&rsquo;s in the room every weekday cohort</span>
  </p>
</section>

<style>
  .fc-lauren-e {
    position: relative;
    height: clamp(560px, 92vh, 920px);
    background: var(--stand-black);
    overflow: hidden;
  }

  /* Light dim only — zine pages keep the photo loud; the heavy yellow
     type carries legibility. */
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep Lauren (just left of frame center) and her face in the crop. */
    object-position: 47% 20%;
    opacity: 0.82;
  }

  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(34px, 4.8vw, 76px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--stand-postit);
  }

  /* The split headline: one phrase pinned to the frame's top-left, the
     payoff pinned to the bottom-left. */
  .top {
    position: absolute;
    top: clamp(24px, 3.5vw, 56px);
    left: clamp(20px, 3vw, 48px);
    right: clamp(20px, 12vw, 200px);
  }

  .bottom {
    position: absolute;
    bottom: clamp(24px, 3.5vw, 56px);
    left: clamp(20px, 3vw, 48px);
  }

  /* Black caption card, bottom-right — sits above the payoff line. */
  .card {
    position: absolute;
    right: clamp(20px, 3vw, 48px);
    bottom: clamp(96px, 14vw, 200px);
    margin: 0;
    max-width: 34ch;
    padding: 14px 16px;
    background: var(--stand-black);
    color: var(--stand-cream);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(11px, 0.95vw, 13px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .card .tag {
    display: block;
    margin-top: 8px;
    color: var(--stand-postit);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .fc-lauren-e {
      height: auto;
      min-height: 620px;
      aspect-ratio: 3 / 4;
    }

    .card {
      left: 20px;
      right: 20px;
      max-width: none;
      bottom: clamp(110px, 26vw, 170px);
    }
  }
</style>
