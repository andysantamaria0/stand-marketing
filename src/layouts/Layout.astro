---
import '@/styles/tokens.css';
import CookieNotice from '@/components/CookieNotice.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Keep pre-launch pages (e.g. /masterclass before the announcement) out of
   *  search indexes without unpublishing them. Remove the flag at launch. */
  noindex?: boolean;
}

const {
  title = 'Stand — Build your own thing. For Real.',
  description = 'Stand is where kids create, launch, and grow real businesses. Brand studio, product lab, storefront, money math — the modern lemonade stand for the next generation.',
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://standkids.com');

// Klaviyo's onsite script renders a full-screen signup popup ~5s after load
// that covers EVERY control on /enroll (email, phone, day chips, add-kid, the
// SMS checkbox, submit) and locks body scroll until it is dismissed. On the
// enrollment page that popup is also a COMPETING signup ask: a parent who
// hands it their email joins the general subscriber list and never enrolls —
// no kid, no phone, no days — while still looking like a successful capture.
// /enroll runs its own PostHog analytics and its Klaviyo profile + metric
// writes happen server-side in /api/enroll/start, so skipping the onsite
// loader here costs no tracking we rely on.
//
// Belt-and-braces: the matching Klaviyo dashboard change (exclude /enroll from
// onsite form targeting) should land too, so a future enrollment URL does not
// re-arm the same trap. This guard is what makes launch not depend on it.
const skipKlaviyoOnsite = Astro.url.pathname.replace(/\/+$/, '') === '/enroll';

// Klaviyo's own init shim, verbatim. It lives here as a string and is emitted
// with `set:html` because Astro renders the children of an `is:inline` script
// as RAW TEXT — a `{`...`}` expression inside one is not evaluated, it is
// printed literally, which silently ships a template literal instead of the
// shim and leaves `window.klaviyo` undefined on every page.
const KLAVIYO_ONSITE_INIT = String.raw`!function(){if(!window.klaviyo){window._klOnsite=window._klOnsite||[];try{window.klaviyo=new Proxy({},{get:function(n,i){return"push"===i?function(){var n;(n=window._klOnsite).push.apply(n,arguments)}:function(){for(var n=arguments.length,o=new Array(n),w=0;w<n;w++)o[w]=arguments[w];var t="function"==typeof o[o.length-1]?o.pop():void 0,e=new Promise((function(n){window._klOnsite.push([i].concat(o,[function(i){t&&t(i),n(i)}]))}));return e}}})}catch(n){window.klaviyo=window.klaviyo||[],window.klaviyo.push=function(){var n;(n=window._klOnsite).push.apply(n,arguments)}}}}();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#faf3d6" />
    <link rel="canonical" href={canonical.toString()} />

    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stand" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={new URL(ogImage, canonical).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonical).toString()} />

    <link rel="preload" href="/fonts/AUTHENTICSans-90.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/AUTHENTICSans-130.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/EditorialNew-Light.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/PiePie-Regular.ttf" as="font" type="font/ttf" crossorigin />

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <CookieNotice />

    <script>
      // Marketing-site analytics — see src/scripts/analytics.ts.
      import "@/scripts/analytics";
    </script>

    <script>
      // Cross-domain attribution hand-off. The marketing site (standkids.com)
      // and the app (app.standkids.com) are separate origins, so the app's
      // first-party attribution cookie can't be read here — the URL is the only
      // carrier across the hop. Forward any incoming UTM / promo params onto
      // every app CTA so the app's AttributionCapture picks them up. When a
      // visitor arrived with no UTMs, tag the link as marketing-site-originated
      // so direct standkids.com -> app conversions are still attributable
      // instead of looking like direct traffic.
      (() => {
        const FORWARD_KEYS = [
          "utm_source",
          "utm_medium",
          "utm_campaign",
          "utm_content",
          "utm_term",
          "promotion_code",
          "code",
        ];
        const incoming = new URLSearchParams(window.location.search);
        const carried = new URLSearchParams();
        for (const key of FORWARD_KEYS) {
          const v = incoming.get(key);
          if (v) carried.set(key, v);
        }

        // First-touch default: an un-tagged marketing-site visit still gets
        // attributed to the site (never overrides a real campaign's UTMs).
        const hasUtm = [...carried.keys()].some((k) => k.startsWith("utm_"));
        if (!hasUtm) {
          carried.set("utm_source", "standkids-site");
          carried.set("utm_medium", "referral");
        }
        if ([...carried].length === 0) return;

        // Also decorate internal /enroll links. Ads should deep-link /enroll with
        // its own UTMs, but a visitor who lands on the homepage first and then
        // clicks through would otherwise arrive with no first-touch attribution
        // at all — the enrollment island reads them off location.search.
        const selector = 'a[href*="app.standkids.com"], a[href^="/enroll"], a[href*="standkids.com/enroll"]';
        for (const a of document.querySelectorAll(selector)) {
          const href = a.getAttribute("href");
          // Never rewrite API/form endpoints (e.g. /api/waitlist) — only nav CTAs.
          if (!href || href.includes("/api/")) continue;
          let url;
          try {
            url = new URL(href, window.location.origin);
          } catch {
            continue;
          }
          // Incoming params win, but don't clobber a value the link already pins.
          for (const [k, v] of carried) {
            if (!url.searchParams.has(k)) url.searchParams.set(k, v);
          }
          a.setAttribute("href", url.toString());
        }
      })();
    </script>

    {/* Klaviyo Onsite tracking (company_id RqafrJ) — powers web tracking +
        the onsite signup forms / waitlist popup. `is:inline` so Astro emits
        both scripts verbatim (the loader must keep its src + async, and the
        _klOnsite init is Klaviyo's own snippet, not a module to bundle). */}
    {
      !skipKlaviyoOnsite && (
        <script
          is:inline
          async
          type="text/javascript"
          src="https://static.klaviyo.com/onsite/js/RqafrJ/klaviyo.js?company_id=RqafrJ"
        />
      )
    }
    {
      !skipKlaviyoOnsite && (
        <script is:inline type="text/javascript" set:html={KLAVIYO_ONSITE_INIT} />
      )
    }
  </body>
</html>
