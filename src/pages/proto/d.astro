---
// Proto D — design-tweak fork of the Founder's Class landing page.
// Components live in src/protos/a/ and are safe to edit freely; production
// (src/components/) is untouched.
//
// Page rhythm per the Aug 24 web-copy doc, minus the bio (Aug 31: the
// founder content lives on /proto/d/about, linked from the nav):
//   nav → video hero → About us → marquee → kid moment → Location →
//   pink collage → FAQ → closing
import Layout from '@/layouts/Layout.astro';
import VideoHero from '@/protos/d/founders/VideoHero.astro';
import NewSpace from '@/protos/d/founders/NewSpace.astro';
import Location from '@/protos/d/founders/Location.astro';
import KidMoment from '@/protos/d/founders/KidMoment.astro';
import WalkAway from '@/protos/d/founders/WalkAway.astro';
import Faq from '@/protos/d/founders/Faq.astro';
import Closing from '@/protos/d/founders/Closing.astro';
import Marquee from '@/protos/d/Marquee.astro';
import Testimonials from '@/protos/d/testimonials/C.astro';
---

<Layout
  noindex
  title="Proto D — Stand Founder's Class"
  description="An 8-week in-person program in LA where kids 8–13 take an idea and build it into a real business — a brand, a product, a plan, and a pitch night. The modern day lemonade stand."
>
  <main class="founders-page">
    <VideoHero />
    <NewSpace />
    <Marquee />
    <KidMoment />
    <Location />
    {/* Meet Lauren + the green credential ticker moved to /proto/d/about
        (Aug 31 review note: About is its own nav page now). */}
    {/* Testimonials — C "mustard stage" won the Sep 3 review (A/B retired,
        recover the lab at 55f3b7f). QUOTES ARE STILL FPO — do not promote
        this section to production until real family quotes land. */}
    <Testimonials />
    <WalkAway />
    <Faq />
    <Closing />
  </main>
</Layout>

<style is:global>
  /* Section tops clear the viewport edge on anchor jumps. Smoothing itself is
     Lenis's job (script below) — CSS scroll-behavior:smooth must stay OFF or
     the two smoothing systems fight over programmatic scrolls. */
  .founders-page [id] {
    scroll-margin-top: var(--space-4);
  }

  /* Shared chunk-reveal (same recipe the About slide established): sections
     mark chunks with data-rv / --rvi, the script below arms them (.rv-ready)
     and fires once ~25% visible (.rv-shown). No JS → static render. */
  .rv-ready [data-rv] {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(2px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
    transition-delay: calc(var(--rvi, 0) * 180ms);
  }

  .rv-shown [data-rv] {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-ready [data-rv] {
      transition: none !important;
    }
  }
</style>

<script>
  // Buttery scroll — Lenis momentum smoothing. The wheel/touch input is
  // intercepted and the real scroll position eased toward the target each
  // animation frame (exponential lerp), which is what reads as "buttery".
  // Reduced-motion users keep native instant scrolling.
  import Lenis from 'lenis';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({
      lerp: 0.1, // smoothing factor per frame: lower = floatier, higher = tighter
      anchors: true, // nav tabs (#about, #location) ride the same easing
    });

    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }

  // Arm the shared chunk-reveals (see is:global style above). One observer
  // per section, one-shot.
  if ('IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.founders-page section').forEach((sec) => {
      if (!sec.querySelector('[data-rv]')) return;
      sec.classList.add('rv-ready');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            sec.classList.add('rv-shown');
            io.disconnect();
          }
        },
        { threshold: 0.25 },
      );
      io.observe(sec);
    });
  }
</script>
