---
// Proto viewer — three panes rendering the REAL pages in scaled iframes at
// true device width (1440 or 390 CSS px) so media queries and fluid type
// behave exactly as production would. Aug 28 lab: all three forks are the
// live homepage + a different "Meet Lauren" bio section under Location —
// A editorial profile, B red pull-quote billboard, C founder's-file card.
// (Aug 25 A/B lab retired; the Aug 24 one recoverable at 38f2c27.)
// Standalone document on purpose: no Layout means no analytics, font preloads,
// or Klaviyo in the chrome; the iframe carries the real thing.
// Aug 31: bio lab retired (D won) — old A/B/C panes + forks recoverable at
// 36f611e. The lab is now the About page: homepage + three About variants.
// About A (3×3 checker) retired Aug 31 — recoverable at 6398d6d.
// About C (values poster) retired Aug 31 — recoverable at 43b6575.
const VARIANTS = [
  { id: 'd', label: 'Homepage (bio moved off)', href: '/proto/d' },
  { id: 'd-about-b', label: 'About B — 2×5 rows', href: '/proto/d/about-b' },
  { id: 'd-about-d', label: 'About D — paper stack', href: '/proto/d/about-d' },
  { id: 'd-about-e', label: 'About E — scrolly index', href: '/proto/d/about-e' },
  { id: 'd-about-f', label: 'About F — assembly line', href: '/proto/d/about-f' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Proto — About lab</title>
  </head>
  <body>
    <header class="bar">
      <h1>Stand landing — proto compare</h1>
      <div class="controls">
        <div class="seg" role="group" aria-label="Viewport width">
          <button type="button" data-width="1440" class="active">Desktop 1440</button>
          <button type="button" data-width="390">Mobile 390</button>
        </div>
        <label class="sync">
          <input type="checkbox" id="sync" checked />
          Sync scroll
        </label>
      </div>
    </header>

    <main class="deck">
      {
        VARIANTS.map((v) => (
          <section class="pane">
            <div class="pane-head">
              <span class="badge">{v.label}</span>
              <a href={v.href} target="_blank" rel="noopener">
                open full page ↗
              </a>
            </div>
            <div class="frame-wrap">
              <iframe src={v.href} title={v.label} loading="eager" />
            </div>
          </section>
        ))
      }
    </main>

    <style>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
        background: #17150f;
        color: #f5efdd;
        font: 13px/1.4 ui-sans-serif, system-ui, sans-serif;
      }
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 16px;
        border-bottom: 1px solid #2c2920;
        flex: none;
      }
      h1 {
        font-size: 13px;
        font-weight: 600;
        margin: 0;
        letter-spacing: 0.01em;
      }
      .controls {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .seg {
        display: flex;
        border: 1px solid #3a362a;
        border-radius: 8px;
        overflow: hidden;
      }
      .seg button {
        appearance: none;
        border: 0;
        background: transparent;
        color: #b8b09a;
        font: inherit;
        padding: 5px 12px;
        cursor: pointer;
      }
      .seg button.active {
        background: #f5efdd;
        color: #17150f;
        font-weight: 600;
      }
      .sync {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        color: #b8b09a;
      }
      .deck {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 10px;
        padding: 10px;
        min-height: 0;
      }
      .pane {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        border: 1px solid #2c2920;
        border-radius: 10px;
        overflow: hidden;
        background: #1e1b14;
      }
      .pane-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 10px;
        flex: none;
        border-bottom: 1px solid #2c2920;
      }
      .badge {
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-size: 11px;
      }
      .pane-head a {
        color: #b8b09a;
        text-decoration: none;
        font-size: 11px;
      }
      .pane-head a:hover {
        color: #f5efdd;
      }
      .frame-wrap {
        flex: 1;
        position: relative;
        overflow: hidden;
        background: #faf3d6;
      }
      .frame-wrap iframe {
        position: absolute;
        top: 0;
        left: 0;
        border: 0;
        transform-origin: top left;
        background: #faf3d6;
      }
    </style>

    <script>
      // Scale-to-fit: each iframe is laid out at the true device width, then
      // transform-scaled so the whole width fits its pane. Height is inflated
      // by 1/scale so the visible area still fills the pane after scaling.
      const wraps = [...document.querySelectorAll<HTMLElement>('.frame-wrap')];
      const frames = [...document.querySelectorAll<HTMLIFrameElement>('.frame-wrap iframe')];
      const segButtons = [...document.querySelectorAll<HTMLButtonElement>('.seg button')];
      const syncBox = document.getElementById('sync') as HTMLInputElement;

      let deviceWidth = 1440;

      function fit() {
        for (const wrap of wraps) {
          const frame = wrap.querySelector('iframe')!;
          const scale = Math.min(wrap.clientWidth / deviceWidth, 1);
          frame.style.width = `${deviceWidth}px`;
          frame.style.height = `${wrap.clientHeight / scale}px`;
          frame.style.transform = `scale(${scale})`;
          // Under-1440 panes fill the width; a 390 frame on a wide pane centers.
          const slack = wrap.clientWidth - deviceWidth * scale;
          frame.style.left = `${Math.max(slack / 2, 0)}px`;
        }
      }

      segButtons.forEach((btn) =>
        btn.addEventListener('click', () => {
          deviceWidth = Number(btn.dataset.width);
          segButtons.forEach((b) => b.classList.toggle('active', b === btn));
          fit();
        })
      );
      new ResizeObserver(fit).observe(document.body);
      fit();

      // Ratio-based scroll sync: variants will diverge in height as they're
      // tweaked, so mirroring absolute scrollTop would drift. Mirroring the
      // scroll *ratio* keeps equivalent sections roughly aligned. The `driving`
      // flag breaks the echo loop (programmatic scrollTo fires scroll events
      // on the mirrored frames, which would otherwise re-drive the original).
      let driving = false;
      function attachSync(frame: HTMLIFrameElement) {
        const win = frame.contentWindow;
        if (!win) return;
        win.addEventListener(
          'scroll',
          () => {
            if (driving || !syncBox.checked) return;
            driving = true;
            const doc = win.document.documentElement;
            const max = doc.scrollHeight - doc.clientHeight;
            const ratio = max > 0 ? win.scrollY / max : 0;
            for (const other of frames) {
              if (other === frame || !other.contentWindow) continue;
              const odoc = other.contentWindow.document.documentElement;
              const omax = odoc.scrollHeight - odoc.clientHeight;
              other.contentWindow.scrollTo(0, ratio * omax);
            }
            requestAnimationFrame(() => (driving = false));
          },
          { passive: true }
        );
      }
      // The deferred module script can run AFTER eager iframes have already
      // fired `load` — waiting on the event alone would attach to none of
      // them. Attach immediately when a frame's document is already complete,
      // and still listen for `load` to re-attach across iframe reloads.
      frames.forEach((f) => {
        f.addEventListener('load', () => attachSync(f));
        if (f.contentDocument?.readyState === 'complete') attachSync(f);
      });
    </script>
  </body>
</html>
