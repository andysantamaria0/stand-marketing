---
/**
 * /enroll — the [Founders Program] intake page.
 *
 * One URL, one form, a client-side state swap. Page 1 is the required stuff;
 * the thank-you screen IS page 2, carrying the optional questions. No payment
 * anywhere this week.
 *
 * REDESIGNED (8/20) to the new design-system comp, then re-grounded to the
 * "offer card" comp the same day: everything on the site's cream, black type,
 * real logo.svg wordmark (mask-tinted), Pie Pie field labels and CTA label,
 * and the skewed white sticker CTA with the hard black shadow. No rounded
 * corners anywhere except day chips. Eyebrow + lede + fact rows cut per JY.
 * The kid section is staged: hidden until email + phone look filled (see the
 * inline script), server-rendered visible so no-JS still gets the full form.
 *
 * The island contract is untouched: every id, data-* attribute and both
 * script blocks are exactly as before — this is a reskin, not a rewire.
 * #enroll-submit must stay a SINGLE TEXT NODE (the island swaps its label via
 * textContent), so the sticker skew lives on a ::before, never an inner span.
 *
 * Deliberate reversal, noted here so nobody "fixes" it back: `Hero.astro` says
 * the marketing site does not capture emails itself. Superseded by the 8/18
 * meeting — /enroll IS the capture surface.
 *
 * Mobile is the PRIMARY target (this is where ad traffic lands): single column,
 * full-width controls, tappable day chips, and the consent block visible in the
 * same glance as the submit button.
 */
import Layout from '@/layouts/Layout.astro';
import { COPY, DAYS } from '@/scripts/enroll/constants';
---

<Layout title={COPY.meta.title} description={COPY.meta.description}>
  <main class="enroll">
    <!-- Enrollment is uncapped (8/21): no waitlist mode, no availability
         check. The page renders open and stays open. -->
    <div id="enroll-root">
      <!-- ── GREEN HEADER BAND ──────────────────────────────────────────── -->
      <header class="hero">
        <a class="close" href="/" aria-label="Close and return to the homepage">&times;</a>
        <div class="wrap">
          {/* tabindex=-1: the island focuses this h1 on the success swap so
              screen readers announce the confirmation it then carries. */}
          <h1 class="title" id="enroll-headline" tabindex="-1">
            <span class="title-logo" role="img" aria-label="STAND"></span>
            <span id="enroll-headline-text">{COPY.open.headline}</span>
          </h1>
          <!-- Hidden by the island on the success swap: once the headline
               carries the confirmation, the sign-up pitch under it is stale. -->
          <p class="lede" id="enroll-lede">{COPY.open.lede}</p>
        </div>
      </header>

      <!-- ── YELLOW SHEET: facts + form ─────────────────────────────────── -->
      <div class="sheet">
        <div class="wrap">
          <!-- ── PAGE 1 ─────────────────────────────────────────────────── -->
          <section id="enroll-page1">
            <form id="enroll-form" novalidate>
              <!-- Side by side on desktop so the unfolded form fits one
                   viewport; stacked on mobile. -->
              <div class="contact">
              <div class="field">
                <label class="label" for="enroll-email">{COPY.form.emailLabel}</label>
                <input
                  class="input"
                  type="email"
                  id="enroll-email"
                  autocomplete="email"
                  inputmode="email"
                  placeholder={COPY.form.emailPlaceholder}
                  required
                />
                <p class="error" id="enroll-email-error" data-error="email" role="alert" hidden></p>
              </div>

              <div class="field">
                <label class="label" for="enroll-phone">{COPY.form.phoneLabel}</label>
                <input
                  class="input"
                  type="tel"
                  id="enroll-phone"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder={COPY.form.phonePlaceholder}
                  required
                />
                <p class="error" id="enroll-phone-error" data-error="phone" role="alert" hidden></p>
              </div>
              </div>

              <!-- Everything below the contact fields is staged: the inline
                   script at the bottom hides this wrapper until email + phone
                   look filled, then reveals it once, permanently. Server-
                   rendered VISIBLE so the form still works without JS. -->
              <div id="enroll-rest">
              <div id="enroll-kids">
                <!-- The first kid block is server-rendered so the form works before
                     the island boots. Extra blocks clone the template below — the
                     same markup, so the two can never drift. -->
                {/* Named with aria-label, not a legend element: that only names a
                    fieldset when it is the fieldset's FIRST child, and the remove
                    button shares this line. Nested in the div it was inert, so
                    every kid block was unnamed and three kids gave a screen reader
                    three identical day-chip groups. syncKidChrome() keeps the
                    label and the visible heading in lockstep on add/remove. */}
                <fieldset class="kid" data-kid-block aria-label={`${COPY.form.kidLegend} 1`}>
                  <button type="button" class="kid-remove" data-kid-remove hidden>
                    {COPY.form.removeKid}
                  </button>

                  <div class="kid-row">
                    <label class="field field-grow">
                      <span class="label">{COPY.form.kidNameLabel}</span>
                      <input
                        class="input"
                        type="text"
                        data-kid-name
                        maxlength="64"
                        autocomplete="off"
                        placeholder={COPY.form.kidNamePlaceholder}
                      />
                    </label>

                    <label class="field field-age">
                      <span class="label">{COPY.form.kidAgeLabel}</span>
                      <input
                        class="input"
                        type="number"
                        data-kid-age
                        min="5"
                        max="17"
                        step="1"
                        inputmode="numeric"
                        placeholder={COPY.form.kidAgePlaceholder}
                      />
                    </label>
                  </div>

                  <!-- Errors sit OUTSIDE the row: inside the fixed 88px age column
                       they would wrap to a dozen lines and blow the layout out. -->
                  <p class="error" data-error="name" role="alert" hidden></p>
                  <p class="error" data-error="age" role="alert" hidden></p>

                  <p class="notice" data-age-notice hidden>{COPY.ageNotice}</p>

                  <div class="field">
                    <span class="label">{COPY.form.kidDaysLabel}</span>
                    <div class="chips">
                      {
                        DAYS.map((day) => (
                          <button type="button" class="chip" data-day={day.value} aria-pressed="false">
                            {day.label}
                          </button>
                        ))
                      }
                    </div>
                    <p class="error" data-error="days" role="alert" hidden></p>
                  </div>
                </fieldset>
              </div>

              <button type="button" class="add-kid" id="enroll-add-kid">{COPY.form.addKid}</button>

              <!-- Consent block, per the reference screenshot: an UNCHECKED SMS
                   checkbox, then the italic privacy line, then the submit button.
                   Submitting covers the program emails; the checkbox is the ONLY
                   thing that permits texting. -->
              <div class="consent">
                <label class="check">
                  <input type="checkbox" id="enroll-sms" />
                  <span>{COPY.form.smsConsent}</span>
                </label>
                <p class="privacy">
                  {COPY.form.privacyPrefix}<a href={COPY.form.privacyHref}
                    >{COPY.form.privacyLinkText}</a
                  >{COPY.form.privacySuffix}
                </p>
              </div>

              <button type="submit" class="submit" id="enroll-submit">{COPY.form.submit}</button>
              <p class="error error-form" id="enroll-form-error" data-error="form" role="alert" hidden>
              </p>
              </div>
            </form>
          </section>

          <!-- ── SUCCESS + the optional questions (this IS page 2) ────────── -->
          <section id="enroll-success" hidden>
            <p class="success-body" id="success-body"></p>

            <p class="details-intro" id="details-intro">{COPY.details.intro}</p>
            <form id="details-form" novalidate>
              <div class="field">
                <label class="label" for="details-location">{COPY.details.locationLabel}</label>
                <input
                  class="input"
                  type="text"
                  id="details-location"
                  maxlength="200"
                  placeholder={COPY.details.locationPlaceholder}
                />
              </div>

              <div class="field">
                <label class="label" for="details-other">{COPY.details.otherCityLabel}</label>
                <input
                  class="input"
                  type="text"
                  id="details-other"
                  maxlength="200"
                  placeholder={COPY.details.otherCityPlaceholder}
                />
              </div>

              <div class="details-actions">
                <button type="submit" class="submit" id="details-submit">{COPY.details.submit}</button>
                <button type="button" class="skip" id="details-skip">{COPY.details.skip}</button>
              </div>
              <p class="error error-form" id="details-error" data-error="details" role="alert" hidden>
              </p>
            </form>
          </section>

          <!-- ── DONE ─────────────────────────────────────────────────────── -->
          <section class="done-panel" id="enroll-done" hidden>
            <p class="done">{COPY.details.done}</p>
            <a class="submit home-btn" href="/">&larr; back home</a>
          </section>
        </div>
      </div>
    </div>

    <!-- Cloned by the island for kids 2-4. Kept in Astro markup rather than
         built as an HTML string so no user data ever meets innerHTML. -->
    <template id="enroll-kid-template">
      <fieldset class="kid" data-kid-block aria-label="">
        <button type="button" class="kid-remove" data-kid-remove>{COPY.form.removeKid}</button>

        <div class="kid-row">
          <label class="field field-grow">
            <span class="label">{COPY.form.kidNameLabel}</span>
            <input
              class="input"
              type="text"
              data-kid-name
              maxlength="64"
              autocomplete="off"
              placeholder={COPY.form.kidNamePlaceholder}
            />
          </label>

          <label class="field field-age">
            <span class="label">{COPY.form.kidAgeLabel}</span>
            <input
              class="input"
              type="number"
              data-kid-age
              min="5"
              max="17"
              step="1"
              inputmode="numeric"
              placeholder={COPY.form.kidAgePlaceholder}
            />
          </label>
        </div>

        <p class="error" data-error="name" role="alert" hidden></p>
        <p class="error" data-error="age" role="alert" hidden></p>

        <p class="notice" data-age-notice hidden>{COPY.ageNotice}</p>

        <div class="field">
          <span class="label">{COPY.form.kidDaysLabel}</span>
          <div class="chips">
            {
              DAYS.map((day) => (
                <button type="button" class="chip" data-day={day.value} aria-pressed="false">
                  {day.label}
                </button>
              ))
            }
          </div>
          <p class="error" data-error="days" role="alert" hidden></p>
        </div>
      </fieldset>
    </template>
  </main>
</Layout>

<script is:inline>
  // The ONE place is:inline is correct on this page: this must run during HTML
  // parsing, before the island bundle has downloaded.
  //
  // The form has no action, so its browser default is a GET navigation to the
  // current URL. Until the island attaches its own preventDefault, a tap on
  // SUBMIT — or Enter in any text field, which `novalidate` does not stop —
  // would reload the page, silently drop the signup, and (if any control ever
  // regains a `name`) put what the parent typed into the URL, where the
  // site-wide PostHog init would capture it as $current_url. This has no env
  // references, so nothing here needs Astro's processing.
  document.addEventListener(
    'submit',
    function (event) {
      event.preventDefault();
    },
    true
  );

  // Staged disclosure: the kid section (and everything after it) stays hidden
  // until email + phone both look plausibly filled. Lives in the same inline
  // script so the hide happens before first paint — and never runs at all
  // without JS, so the no-JS form remains complete. The reveal is a ONE-WAY
  // latch: editing the email afterwards must never hide a half-filled kid
  // block. The plausibility checks are deliberately looser than the island's
  // real validation — this gates pacing, not correctness; submit still owns
  // the hard errors.
  (function () {
    var rest = document.getElementById('enroll-rest');
    var email = document.getElementById('enroll-email');
    var phone = document.getElementById('enroll-phone');
    if (!rest || !email || !phone) return;

    var ready = function () {
      var emailOk = /\S+@\S+\.\S+/.test(email.value);
      var digits = phone.value.replace(/\D/g, '');
      var phoneOk =
        digits.length >= 10 || (phone.value.trim().charAt(0) === '+' && digits.length >= 8);
      return emailOk && phoneOk;
    };

    // Autofill or bfcache restore may land with both fields already set —
    // never hide a form that is already past the gate.
    if (ready()) return;

    rest.hidden = true;
    var reveal = function () {
      if (!ready()) return;
      rest.hidden = false;
      // The entrance animation keys off this class, NOT :not([hidden]), so the
      // no-JS page (where the section was never hidden) never plays it on load.
      rest.classList.add('revealed');
      email.removeEventListener('input', reveal);
      phone.removeEventListener('input', reveal);
    };
    email.addEventListener('input', reveal);
    phone.addEventListener('input', reveal);
  })();
</script>

<script>
  // Processed module script — NOT is:inline and NOT define:vars. Both skip
  // Astro's processing, which would leave PUBLIC_ENROLL_API_BASE un-inlined and
  // point every submit at the literal string "undefined".
  import '@/scripts/enroll/island';
</script>

<script>
  // DEV-ONLY state preview for design iteration, no backend needed:
  //   /enroll?preview=success   → page 2 (success + optional questions)
  //   /enroll?preview=done      → the final screen
  // `import.meta.env.DEV` is statically false in `astro build`, so this whole
  // block is dead-code-eliminated from production — the param does nothing live.
  import { COPY } from '@/scripts/enroll/constants';

  if (import.meta.env.DEV) {
    const mode = new URLSearchParams(location.search).get('preview');
    if (mode === 'success' || mode === 'done') {
      const page1 = document.getElementById('enroll-page1');
      const success = document.getElementById('enroll-success');
      const done = document.getElementById('enroll-done');
      if (page1) page1.hidden = true;
      // Both previews are past page 1, where the island hides the lede.
      const lede = document.getElementById('enroll-lede');
      if (lede) lede.hidden = true;
      if (mode === 'done') {
        if (done) done.hidden = false;
        const headline = document.getElementById('enroll-headline');
        if (headline) headline.hidden = true;
      } else if (success) {
        success.hidden = false;
        const copy = COPY.success.open;
        const headline = document.getElementById('enroll-headline');
        const body = document.getElementById('success-body');
        if (headline) {
          // Same rule as the island: write the SPAN, never the h1, or the
          // wordmark beside it is deleted. See setHeadlineText() in island.ts.
          const headlineText = document.getElementById('enroll-headline-text');
          if (headlineText) headlineText.textContent = copy.headline;
          // Replays the real success choreography so the preview matches.
          headline.classList.add('is-confirmed');
        }
        if (body) {
          body.textContent = copy.body;
          body.hidden = copy.body === '';
        }
      }
    }
  }
</script>

<style>
  /* Design-system ground rules, from the comp: flat full-bleed color blocks,
     no border-radius anywhere except the day-chip pills, 2px ink strokes on
     controls, hard offset shadows only on the sticker CTA. */
  .enroll {
    background: var(--stand-cream);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  #enroll-root {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .wrap {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ── Header ────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--stand-cream);
    padding: 20px 0 8px;
  }

  /* Corner escape hatch — mirrors the wordmark back-link, for visitors who
     scan for an X to leave the form. */
  .close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-family: var(--font-sans);
    font-size: 30px;
    line-height: 1;
    color: var(--stand-black);
    transition: transform 120ms ease;
  }

  .close:hover {
    transform: scale(1.15);
  }

  .close:focus-visible {
    outline: 3px solid var(--stand-green);
    outline-offset: 2px;
  }

  /* The word STAND in the headline IS the wordmark, in brand red. Masked
     rather than an <img> so the colour is a CSS token rather than baked into
     the asset, and sized in `em` so it tracks the clamped title size at every
     breakpoint without its own media queries. 3em wide lands its height on the
     display face's cap height.

     It is a SIBLING of #enroll-headline-text and never a child, because the
     island rewrites that span's textContent on every step change. See
     setHeadlineText() in island.ts for why that distinction is load-bearing. */
  .title-logo {
    display: inline-block;
    /* 3.5em wide -> 0.83em tall, matching Pie Pie's cap height so the mark
       reads at the same size as the capitals beside it. The viewBox is tight
       to the artwork, so height here IS letterform height, not a padded box. */
    width: 3.5em;
    aspect-ratio: 199.29 / 47.33;
    /* Brand red, the colour the wordmark carried as the old home link — not
       currentColor, so it stays red against the black headline type. */
    background-color: var(--stand-red);
    -webkit-mask: url('/brand/logo.svg') no-repeat left center / contain;
    mask: url('/brand/logo.svg') no-repeat left center / contain;
    /* An inline-block with no in-flow content takes its bottom margin edge as
       its baseline, and the viewBox is tight to the letterforms — so the
       wordmark's feet land on the text baseline with no nudge. An earlier
       translateY here assumed padding in the asset that does not exist. */
    vertical-align: baseline;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 8.5vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.5px;
    color: var(--stand-black);
    margin: 0;
  }

  .lede {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    color: var(--stand-black);
    margin: 12px 0 0;
    max-width: 46ch;
  }

  /* ── Form area — same cream, one continuous field like the comp ────── */
  .sheet {
    background: var(--stand-cream);
    color: var(--stand-black);
    flex: 1;
    padding: 28px 0 80px;
  }

  .field {
    margin-bottom: 14px;
  }

  /* ── Staged-reveal entrance ────────────────────────────────────────────
     Plays only when the inline script adds .revealed — never on a plain
     page load. Each direct child (kid card, add-kid, consent, submit)
     rises in with a small stagger. `both` fill keeps the delayed rows
     invisible until their turn instead of flashing at full opacity. */
  @keyframes rest-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  #enroll-rest.revealed > :global(*) {
    animation: rest-in 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  #enroll-rest.revealed > :global(:nth-child(2)) {
    animation-delay: 70ms;
  }

  #enroll-rest.revealed > :global(:nth-child(3)) {
    animation-delay: 140ms;
  }

  #enroll-rest.revealed > :global(:nth-child(n + 4)) {
    animation-delay: 210ms;
  }

  /* All field labels in Authentic Sans bold. Pie Pie stays reserved for the
     headline, the sticker CTA, and the done screen. */
  .label {
    display: block;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0;
    margin-bottom: 6px;
  }

  .input {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 16px; /* 16px minimum, or iOS Safari zooms on focus. */
    color: var(--stand-black);
    background: var(--stand-white);
    border: 2px solid var(--stand-black);
    border-radius: 0;
    padding: 12px 14px;
    outline: none;
    transition: box-shadow 120ms ease-out;
  }

  /* Focus = the sticker pop: a hard ink shadow, not a soft glow. */
  .input:focus-visible {
    box-shadow: 3px 3px 0 var(--stand-black);
  }

  .error {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 700;
    color: var(--stand-red);
    margin: 6px 0 0;
  }

  .error[hidden] {
    display: none;
  }

  .error-form {
    margin-top: 12px;
    text-align: center;
  }

  /* Kid blocks: an open 2px ink frame on the yellow — no fill, no lift.
     The white inputs inside carry the contrast. */
  .kid {
    position: relative;
    border: 2px solid var(--stand-black);
    border-radius: 0;
    background: transparent;
    padding: 14px 14px 2px;
    margin: 0 0 14px;
  }

  /* No visible "Kid N" legend (the fieldset aria-label still carries it for
     screen readers), so Remove anchors to the frame's top-right corner. */
  .kid-remove {
    position: absolute;
    top: 0;
    right: 6px;
    font-family: var(--font-sans);
    font-size: 14px;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    /* The rest of the page holds 44px; this control was ~20px because
       tokens.css resets button padding to 0 globally. */
    min-height: 44px;
    padding: 0 8px;
  }

  .kid-remove[hidden] {
    display: none;
  }

  /* Only when Remove is visible (2+ kids) does the frame need headroom for
     it — otherwise it would sit on top of the Age label. */
  .kid:has([data-kid-remove]:not([hidden])) {
    padding-top: 36px;
  }

  .kid-row {
    display: flex;
    gap: 12px;
  }

  .field-grow {
    flex: 1;
    min-width: 0;
  }

  .field-age {
    width: 88px;
    flex: none;
  }

  /* Post-it slip on the cream ground. */
  .notice {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
    background: var(--stand-postit);
    border: 2px solid var(--stand-black);
    border-radius: 0;
    padding: 10px 12px;
    margin: 0 0 18px;
  }

  .notice[hidden] {
    display: none;
  }

  /* Day chips: the ONE rounded shape in the system. White pills; selected
     flips to green with cream text (the brand's filled-surface pair). */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--stand-black);
    border-radius: 999px;
    background: var(--stand-white);
    color: var(--stand-black);
  }

  .chip[aria-pressed='true'] {
    background: var(--stand-green);
    color: var(--stand-cream);
    box-shadow: 2px 2px 0 var(--stand-black);
  }

  .add-kid {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--stand-black);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    min-height: 44px;
    margin-bottom: 12px;
  }

  .add-kid:disabled {
    opacity: 0.35;
    text-decoration: none;
    cursor: default;
  }

  /* Consent sits directly above submit so the small print is in the same
     glance as the button, per the reference screenshot. */
  .consent {
    margin-bottom: 14px;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.45;
    cursor: pointer;
  }

  .check input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--stand-green);
  }

  .privacy {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: 11px;
    line-height: 1.45;
    margin: 6px 0 0;
  }

  .privacy a {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  /* ── The sticker CTA ───────────────────────────────────────────────────
     The comp's "sign up now" button: a skewed white sticker with a hard ink
     shadow and a straight, heavy lowercase label. The island swaps this
     button's label via textContent, so the button must stay a single text
     node — the sticker is a ::before layer, NOT a wrapper span. isolation
     keeps its z-index:-1 above the yellow sheet but under the label. */
  .submit {
    position: relative;
    isolation: isolate;
    display: block;
