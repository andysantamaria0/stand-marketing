---
// Homepage — Founder's Class landing (in-person LA program, Oct 2026).
// Design promoted from Proto A after the Aug 24 A/B/C review (viewer lives
// at /proto). Page rhythm:
//
//   nav (socials next to wordmark) → video hero → About us (Pie Pie
//   "modern day lemonade stand" stack) → marquee → kid moment → Location
//   (week-by-week, scannable) → green collage → FAQ → closing
//
// Every CTA routes to /enroll (owned by Andy — email-first, then payment;
// see the Enrollment Journey doc for the email_captured / payment_completed
// contract).
//
// Launch checklist:
//   [ ] Hero film → /public/brand/hero-video.mp4
//   [ ] Photography: program-kids, kid-moment, lauren portraits
//   [ ] /enroll live (Andy) before this page ships — every CTA points there
import Layout from '@/layouts/Layout.astro';
import VideoHero from '@/components/founders/VideoHero.astro';
import NewSpace from '@/components/founders/NewSpace.astro';
import Location from '@/components/founders/Location.astro';
import KidMoment from '@/components/founders/KidMoment.astro';
import WalkAway from '@/components/founders/WalkAway.astro';
import Faq from '@/components/founders/Faq.astro';
import Closing from '@/components/founders/Closing.astro';
// Carried over from the previous homepage — same brand furniture, new story.
import Marquee from '@/components/Marquee.astro';
---

<Layout
  title="Stand — Build your own thing. For Real."
  description="An 8-week in-person program in LA where kids 8–13 take an idea and build it into a real business — a brand, a product, a plan, and a pitch night. The modern day lemonade stand."
>
  <main class="founders-page">
    <VideoHero />
    <NewSpace />
    <Marquee />
    <KidMoment />
    <Location />
    <WalkAway />
    <Faq />
    <Closing />
  </main>
</Layout>

<style is:global>
  /* Section tops clear the viewport edge on anchor jumps. Smoothing itself is
     Lenis's job (script below) — CSS scroll-behavior:smooth must stay OFF or
     the two smoothing systems fight over programmatic scrolls. */
  .founders-page [id] {
    scroll-margin-top: var(--space-4);
  }

  /* Shared chunk-reveal (same recipe the About slide established): sections
     mark chunks with data-rv / --rvi, the script below arms them (.rv-ready)
     and fires once ~25% visible (.rv-shown). No JS → static render. */
  .rv-ready [data-rv] {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(2px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
    transition-delay: calc(var(--rvi, 0) * 180ms);
  }

  .rv-shown [data-rv] {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-ready [data-rv] {
      transition: none !important;
    }
  }
</style>

<script>
  // Buttery scroll — Lenis momentum smoothing. The wheel/touch input is
  // intercepted and the real scroll position eased toward the target each
  // animation frame (exponential lerp), which is what reads as "buttery".
  // Reduced-motion users keep native instant scrolling.
  import Lenis from 'lenis';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({
      lerp: 0.1, // smoothing factor per frame: lower = floatier, higher = tighter
      anchors: true, // nav tabs (#about, #location) ride the same easing
    });

    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }

  // Arm the shared chunk-reveals (see is:global style above). One observer
  // per section, one-shot.
  if ('IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.founders-page section').forEach((sec) => {
      if (!sec.querySelector('[data-rv]')) return;
      sec.classList.add('rv-ready');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            sec.classList.add('rv-shown');
            io.disconnect();
          }
        },
        { threshold: 0.25 },
      );
      io.observe(sec);
    });
  }
</script>
