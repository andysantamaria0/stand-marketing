---
// /masterclass — "Kickstart Your Business Builder" landing page (45-day sprint).
//
// Skeleton created 2026-08-03 per planning meeting. This is a WIREFRAME:
// every piece of narrative copy is a visible <placeholder> token that Lauren /
// Celestine replace before the Aug 5 announcement. Functional microcopy (form
// labels, validation messages) is real and stays.
//
// Launch checklist:
//   [ ] Curriculum beats + time splits from Lauren's one-pager (section: minutes)
//   [ ] Founder bio copy + photo (section: founder) — photo at /brand/lauren.webp
//   [ ] FAQ answers reviewed by Lauren (section: faq)
//   [ ] Signup endpoint live on app.standkids.com (contract below)
//   [ ] Remove `noindex` from <Layout> at announcement
//   [ ] OG image for the announcement post (og:image currently site default)
//
// ── Signup capture contract (app-side work, owned by Andy) ────────────────────
// This repo is a static site with no backend, so the form POSTs JSON to the app
// origin, which already owns Supabase + Resend:
//
//   POST https://app.standkids.com/api/masterclass-signup
//   Content-Type: application/json
//   { parentName: string, parentEmail: string, kidFirstName: string,
//     kidAge: string, source: "masterclass-landing", utm: Record<string,string> }
//
//   → 200 { status: "confirmed" }   seat secured (send confirmation email +
//                                   calendar invite via Resend; reminders T-24h/T-1h)
//   → 200 { status: "waitlist" }    the 12 seats are gone; store on the
//                                   "August cohort first dibs" list
//   → 4xx/5xx                       page shows the mailto fallback
//
// CORS: allow origin https://standkids.com. De-dupe by parentEmail (idempotent
// re-submits, same as the waitlist table).
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/Footer.astro';

// Real decided data (meeting notes): countdown target for the urgency widget.
const EVENT_START_ISO = '2026-08-24T16:30:00-07:00';

const EVENT = {
  weekday: 'Monday',
  date: 'August 24',
  time: '4:30 PM PT / 7:30 PM ET',
  length: '90 minutes',
  lengthAdj: '90-minute',
  where: 'Live on Zoom',
  seats: 12,
  ages: '10–16',
};

// Wireframe slots — Lauren's one-pager fills these (4 beats, ~90 min total).
const beats = Array.from({ length: 4 }, (_, i) => ({
  minutes: '<min>',
  title: `<Step ${i + 1} title>`,
  body: '<Body text — what happens in this step, what the kid produces>',
}));

// Wireframe slots — parent FAQ, Lauren to write (format, age range, what the
// kid needs, what happens after, free?, safety).
const faqs = Array.from({ length: 6 }, (_, i) => ({
  q: `<Question ${i + 1}>`,
  a: '<Answer — plain, reassuring, parent-voiced>',
}));
---

<Layout
  title="Stand — Kickstart Your Business Builder · A live masterclass for kids"
  description={`A free, live 90-minute masterclass for kids ${EVENT.ages}. ${EVENT.weekday}, ${EVENT.date} — every kid leaves with a real business idea and a path to launching it on Stand. ${EVENT.seats} spots only.`}
  noindex
>
  <main class="mc">
    <!-- ── Nav (same lightweight pattern as /faq) ─────────────────────────── -->
    <nav class="mc-nav">
      <a href="/" class="back-link">
        <img src="/brand/logo.svg" alt="Stand" width="100" />
      </a>
      <a href="#signup" class="nav-cta">&lt;CTA&gt; &rarr;</a>
    </nav>

    <!-- ── 1 · Hero — giant type IS the poster (Toca superfans structure:
         program name as a viewport-filling wordmark, a product sticker embedded
         inside it, hand-drawn burst accent). Sticky: the sections that follow
         slide up over it. ──────────────────────────────────────────────────── -->
    <section class="hero" aria-labelledby="mc-title">
      <h1 id="mc-title" class="hero-title">
        &lt;Masterclass<span class="hero-sticker"
          ><img src="/brand/STAND_PNG_YellowSticker.webp" alt="" /></span
        >title&gt;
      </h1>

      <p class="hero-sub">
        &lt;One-line value prop &mdash; who it&rsquo;s for,
        <em>what they walk out with&gt;</em>
      </p>

      <ul class="event-facts" aria-label="Event details">
        <li>&lt;Date&gt;</li>
        <li>&lt;Time&gt;</li>
        <li>&lt;Platform&gt;</li>
      </ul>

      <a href="#signup" class="cta-btn">&lt;CTA&gt; &rarr;</a>
    </section>

    <div class="mc-rest">
    <!-- ── 1b · Poster — full-bleed red statement section that slides over the
         pinned hero, carrying the scarcity story in giant type. ───────────── -->
    <section class="poster" aria-labelledby="poster-title">
      <h2 id="poster-title" class="poster-title">&lt;Scarcity statement&gt;</h2>
      <p class="poster-sub">&lt;Event details &middot; urgency line&gt;</p>
      <a href="#signup" class="cta-btn cta-btn-postit">&lt;CTA&gt; &rarr;</a>
    </section>

    <!-- ── 1c · Social proof strip ────────────────────────────────────────── -->
    <section class="proof" aria-label="Credibility">
      <p class="proof-line">
        &lt;Social proof &mdash; <strong>founder credential</strong> &middot;
        press logos &middot; testimonials&gt;
      </p>
    </section>

    <!-- ── 2 · The promise, made tangible ─────────────────────────────────── -->
    <section class="promise" aria-labelledby="promise-title">
      <h2 id="promise-title" class="headline section-title">
        &lt;Section title &mdash; the promise&gt;
      </h2>
      <div class="promise-grid">
        {
          [1, 2, 3].map((i) => (
            <article class="promise-card">
              <h3 class="name">&lt;Outcome {i} title&gt;</h3>
              <p class="desc">
                &lt;Body text &mdash; the tangible thing every kid leaves with&gt;
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ── 3 · The 90 minutes (placeholder until Lauren's one-pager) ──────── -->
    <section class="minutes" aria-labelledby="minutes-title">
      <h2 id="minutes-title" class="headline section-title">
        &lt;Section title &mdash; curriculum&gt;
      </h2>
      <ol class="beats">
        {
          beats.map((b) => (
            <li class="beat">
              <div class="beat-body">
                <h3 class="name">
                  {b.title} <span class="beat-minutes">{b.minutes}</span>
                </h3>
                <p class="desc">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ── 4 · The founder — where the announcement traffic lands ─────────── -->
    <section class="founder" aria-labelledby="founder-title">
      <div class="founder-photo" aria-hidden="true">
        <!-- TODO(asset): founder photo → /brand/lauren.webp, then replace this frame. -->
        <span class="photo-placeholder">Photo</span>
      </div>
      <div class="founder-copy">
        <h2 id="founder-title" class="headline">&lt;Founder headline&gt;</h2>
        <p class="lede founder-cred">&lt;Credential line&gt;</p>
        <p class="desc">
          &lt;Founder bio &mdash; the trust transfer: who Lauren is, why she
          built Stand, why she&rsquo;s teaching this class herself&gt;
        </p>
      </div>
    </section>

    <!-- ── 5 · Parent FAQ ─────────────────────────────────────────────────── -->
    <!-- Full-bleed wavy divider introducing the FAQ. -->
    <div class="wave-divider" aria-hidden="true"></div>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="headline section-title">FAQ</h2>
      <div class="faq-list">
        {
          faqs.map((item) => (
            <details class="faq-item">
              <summary class="q">{item.q}</summary>
              <p class="a desc">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ── 6 · Signup ─────────────────────────────────────────────────────── -->
    <section class="signup" id="signup" aria-labelledby="signup-title">
      <div class="signup-grid">
        <div class="signup-copy">
          <h2 id="signup-title" class="signup-title">&lt;Form title&gt;</h2>
          <p class="signup-when">&lt;Event details &middot; price&gt;</p>
          <p class="signup-blurb">
            &lt;Post-signup expectations &mdash; confirmation email, calendar
            invite, reminders, what happens when spots run out&gt;
          </p>
        </div>

        <div class="signup-form-col">
        <form id="mc-form" novalidate>
          <div class="field-row">
            <label class="field">
              <span class="field-label">Kid&rsquo;s first name</span>
              <input type="text" name="kidFirstName" autocomplete="off" required />
            </label>
            <label class="field field-age">
              <span class="field-label">Kid&rsquo;s age</span>
              <select name="kidAge" required>
                <option value="" selected disabled>&nbsp;</option>
                {Array.from({ length: 7 }, (_, i) => 10 + i).map((age) => (
                  <option value={String(age)}>{age}</option>
                ))}
              </select>
            </label>
          </div>
          <label class="field">
            <span class="field-label">Your name</span>
            <input type="text" name="parentName" autocomplete="name" required />
          </label>
          <label class="field">
            <span class="field-label">Your email</span>
            <input type="email" name="parentEmail" autocomplete="email" required />
          </label>

          <!-- Honeypot: hidden from humans; bots that fill it are dropped
               client-side (and the endpoint should drop it server-side too). -->
          <label class="hp" aria-hidden="true">
            Company
            <input type="text" name="company" tabindex="-1" autocomplete="off" />
          </label>

          <button type="submit" class="cta-btn cta-btn-postit submit-btn">
            &lt;CTA&gt; &rarr;
          </button>
          <p class="form-status" id="mc-status" role="status" aria-live="polite"></p>
        </form>

        <!-- Post-submit states: swapped in by the script below. -->
        <div class="confirm confirm-seat" hidden>
          <p class="confirm-big">&lt;Confirmed headline&gt;</p>
          <p class="desc">
            &lt;Confirmed body &mdash; check email, calendar invite, reminders&gt;
          </p>
        </div>
        <div class="confirm confirm-waitlist" hidden>
          <p class="confirm-big">&lt;Waitlist headline&gt;</p>
          <p class="desc">
            &lt;Waitlist body &mdash; spots full, first in line for the next
            session&gt;
          </p>
        </div>
        </div>
      </div>
    </section>
    </div>

    <!-- ── Countdown — sticky urgency widget (Ramen Bae reference). Ticks to
         the real event start; clicking jumps to the signup form; hides itself
         once the class has begun. ─────────────────────────────────────────── -->
    <a
      href="#signup"
      id="mc-countdown"
      class="countdown"
      data-target={EVENT_START_ISO}
      aria-label="Time left until the masterclass — jump to signup"
    >
      <span class="countdown-label">&lt;Urgency label&gt;</span>
      <span class="countdown-cells" role="timer">
        <span class="cell"><b data-cd="d">00</b><i>days</i></span>
        <em aria-hidden="true">:</em>
        <span class="cell"><b data-cd="h">00</b><i>hrs</i></span>
        <em aria-hidden="true">:</em>
        <span class="cell"><b data-cd="m">00</b><i>min</i></span>
        <em aria-hidden="true">:</em>
        <span class="cell"><b data-cd="s">00</b><i>sec</i></span>
      </span>
    </a>
  </main>
  <Footer />
</Layout>

<script>
  import posthog from 'posthog-js';

  const ENDPOINT = 'https://app.standkids.com/api/masterclass-signup';

  const form = document.getElementById('mc-form') as HTMLFormElement | null;
  const status = document.getElementById('mc-status');
  const seatConfirm = document.querySelector<HTMLElement>('.confirm-seat');
  const waitlistConfirm = document.querySelector<HTMLElement>('.confirm-waitlist');

  // Analytics is best-effort — an ad blocker must never affect the form.
  const track = (event: string, props?: Record<string, unknown>) => {
    try { posthog.capture(event, props); } catch { /* non-critical */ }
  };

  // Forward the visitor's campaign params into the signup payload so each of
  // the 12 seats is attributable to a channel (LinkedIn vs email vs IG) — the
  // sprint's KPI is signups per channel, and the static site has no other way
  // to join a signup back to its source.
  const utm: Record<string, string> = {};
  new URLSearchParams(window.location.search).forEach((v, k) => {
    if (k.startsWith('utm_')) utm[k] = v;
  });

  let submitting = false;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitting) return; // double-click guard — one seat request per visitor

    const data = new FormData(form);
    const payload = {
      parentName: String(data.get('parentName') ?? '').trim(),
      parentEmail: String(data.get('parentEmail') ?? '').trim(),
      kidFirstName: String(data.get('kidFirstName') ?? '').trim(),
      kidAge: String(data.get('kidAge') ?? ''),
      source: 'masterclass-landing',
      utm,
    };

    // Honeypot tripped → silently succeed so the bot learns nothing.
    if (String(data.get('company') ?? '') !== '') {
      form.hidden = true;
      if (seatConfirm) seatConfirm.hidden = false;
      return;
    }

    // On validation failure, focus the first offending field — the status line
    // renders below the submit button, so focus is what actually points the
    // parent at the problem.
    const firstEmpty = (['kidFirstName', 'kidAge', 'parentName', 'parentEmail'] as const).find(
      (name) => !String(data.get(name) ?? '').trim(),
    );
    if (firstEmpty) {
      if (status) status.textContent = 'Please fill in every field — it takes 30 seconds.';
      const el = form.elements.namedItem(firstEmpty);
      if (el instanceof HTMLElement) el.focus();
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.parentEmail)) {
      if (status) status.textContent = 'That email doesn’t look right — mind checking it?';
      (form.elements.namedItem('parentEmail') as HTMLElement | null)?.focus();
      return;
    }

    submitting = true;
    if (status) status.textContent = 'Saving your spot…';
    track('masterclass_signup_submitted', { kid_age: payload.kidAge, ...utm });

    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const body = await res.json().catch(() => ({ status: 'confirmed' }));

      form.hidden = true;
      const waitlisted = body.status === 'waitlist';
      if (waitlisted && waitlistConfirm) waitlistConfirm.hidden = false;
      else if (seatConfirm) seatConfirm.hidden = false;
      track('masterclass_signup_succeeded', { status: body.status ?? 'confirmed' });
    } catch {
      // Endpoint down / not deployed yet / CORS — give the parent a human path
      // instead of a dead end. hello@ is monitored; a seat is worth an email.
      submitting = false;
      if (status) {
        status.innerHTML =
          'Hmm, that didn’t go through. Email us at <a href="mailto:hello@standkids.com?subject=Masterclass%20signup">hello@standkids.com</a> and we’ll save the spot by hand.';
      }
      track('masterclass_signup_failed');
    }
  });

  // Staggered entrances (promise cards + curriculum beats): one-shot reveal
  // when the group is ~20% visible. is-ready arms the hidden state only when
  // JS runs (no-JS renders static).
  if ('IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.promise-grid, .beats').forEach((group) => {
      group.classList.add('is-ready');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            group.classList.add('is-shown');
            io.disconnect();
          }
        },
        { threshold: 0.2 },
      );
      io.observe(group);
    });
  }

  // Countdown to the event start. Cheap DOM writes once a second; the widget
  // removes itself when the class has started (urgency has no meaning then).
  const cd = document.getElementById('mc-countdown');
  if (cd) {
    const target = new Date(cd.dataset.target ?? '').getTime();
    const cells: Record<string, HTMLElement | null> = {
      d: cd.querySelector('[data-cd="d"]'),
      h: cd.querySelector('[data-cd="h"]'),
      m: cd.querySelector('[data-cd="m"]'),
      s: cd.querySelector('[data-cd="s"]'),
    };
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const diff = target - Date.now();
      if (!Number.isFinite(target) || diff <= 0) {
        cd.remove();
        window.clearInterval(timer);
        return;
      }
      if (cells.d) cells.d.textContent = pad(Math.floor(diff / 86_400_000));
      if (cells.h) cells.h.textContent = pad(Math.floor(diff / 3_600_000) % 24);
      if (cells.m) cells.m.textContent = pad(Math.floor(diff / 60_000) % 60);
      if (cells.s) cells.s.textContent = pad(Math.floor(diff / 1000) % 60);
    };
    const timer = window.setInterval(tick, 1000);
    tick();
  }

  // Smooth-scroll the hero/nav CTAs to the form (instant when the visitor
  // prefers reduced motion — a long animated scroll is exactly the kind of
  // large-viewport movement that setting exists for).
  document.querySelectorAll<HTMLAnchorElement>('a[href="#signup"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document
        .getElementById('signup')
        ?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
      track('masterclass_cta_clicked');
    });
  });
</script>

<style>
  .mc {
    background: var(--stand-cream);
    color: var(--stand-black);
    font-family: var(--font-sans);
    /* No overflow-x:hidden here — that would make .mc a scroll container,
       hijacking the panels' view() timelines (they'd resolve against .mc,
       which never scrolls, and freeze at their end state). The body already
       clips horizontal overflow and propagates it to the viewport. */
    /* Colored sections render as inset rounded "cards" (Toca treatment):
       page background shows around each panel through this gap. */
    --band-gap: clamp(12px, 1.8vw, 28px);
    --band-radius: clamp(20px, 3vw, 44px);
  }

  .poster,
  .proof,
  .minutes {
    width: calc(100% - 2 * var(--band-gap));
    max-width: none;
    margin-left: auto;
    margin-right: auto;
    border-radius: var(--band-radius);
  }

  /* Like the hero: each color panel grows to full-bleed as it scrolls into
     view. view() gives every panel its own timeline — the expansion happens
     while the panel travels from viewport entry to ~35% coverage, then holds.
     Browsers without scroll-driven animations (and reduced-motion) keep the
     inset rounded cards. */
  /* The minutes panel opts out: it stays an inset, outlined card. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .poster,
      .proof {
        animation: band-expand linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }

  @keyframes band-expand {
    from {
      width: calc(100% - 2 * var(--band-gap));
      border-radius: var(--band-radius);
    }
    to {
      width: 100%;
      border-radius: 0;
    }
  }

  /* ── Nav ─────────────────────────────────────────────────────────────── */
  /* Logo centered in the bar (Bored Cow / Toca nav pattern); the CTA holds
     the right edge and a mirrored empty column keeps the logo truly centered. */
  .mc-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 24px 48px;
    gap: 24px;
  }

  .mc-nav .back-link {
    line-height: 0;
    grid-column: 2;
  }

  .mc-nav .nav-cta {
    grid-column: 3;
    justify-self: end;
  }

  .nav-cta {
    font-family: var(--font-serif);
    font-size: 16px;
    letter-spacing: -0.4px;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 2px;
    /* The text is ~22px tall — padding grows the tap target past the 44px
       floor, and the negative margin keeps the nav bar's visual height. */
    display: inline-block;
    padding: 12px 8px;
    margin: -12px -8px;
  }

  /* ── Shared bits ─────────────────────────────────────────────────────── */
  section {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(48px, 8vh, 96px) 24px;
  }

  .section-title {
    font-weight: 700;
    margin: 0 0 clamp(24px, 4vh, 44px);
  }

/* Rounded pill CTA (Bored Cow / Ramen Bae button language). */
  .cta-btn {
    display: inline-block;
    background: var(--stand-red);
    color: var(--stand-cream);
    border: 2px solid var(--stand-black);
    border-radius: 999px;
    padding: 16px 36px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1;
    transition: background-color 0.15s ease;
  }

  /* Hover is a color swap, not motion. */
  .cta-btn:hover {
    background: var(--stand-black);
    color: var(--stand-cream);
  }

  /* ── Hero ────────────────────────────────────────────────────────────────
     Toca-superfans structure: the event name as a viewport-filling wordmark.
     The hero is sticky at the top of the stack (z-index 0) so .mc-rest slides
     up and over it on scroll — position-driven, so it costs nothing and needs
     no reduced-motion branch. */
  .hero {
    position: sticky;
    /* Pins with a cream gap above, so the card reads as a card even frozen. */
    top: var(--band-gap);
    z-index: 0;
    text-align: center;
    /* The hero is itself a rounded post-it card on the cream canvas (the
       Bored Cow page frame): every colored moment on this page is a card. */
    width: calc(100% - 2 * var(--band-gap));
    max-width: none;
    margin: 0 auto;
    background: var(--stand-postit);
    border-radius: var(--band-radius);
    padding-top: clamp(64px, 10vh, 128px);
    padding-bottom: clamp(40px, 7vh, 88px);
  }

  /* As the page scrolls, the post-it card grows from inset-rounded to
     full-bleed (scroll-driven, no JS; browsers without support just keep the
     inset card). Width/radius here are cheap: the hero repaints alone. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero {
        animation: hero-expand linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 70vh;
      }
    }
  }

  @keyframes hero-expand {
    to {
      width: 100%;
      top: 0;
      border-radius: 0;
    }
  }

  /* All post-hero content paints above the pinned hero. The opaque background
     is load-bearing: without it the hero would show through every section. */
  .mc-rest {
    position: relative;
    z-index: 1;
    background: var(--stand-cream);
  }

  .hero-title {
    position: relative;
    font-weight: 900;
    /* Fills the frame like a wordmark: sized to make "Kickstart Your" span
       the viewport on two lines. */
    font-size: clamp(52px, 9.6vw, 150px);
    line-height: 0.98;
    letter-spacing: clamp(-4px, -0.03em, -1px);
    margin: 0 auto 24px;
    max-width: 12ch;
  }

  /* Product sticker embedded inside the wordmark — the Toca "emoji in the
     logotype" move, with a Stand product PNG instead. */
  .hero-sticker {
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    margin: 0 0.06em;
    vertical-align: -0.12em;
  }

  .hero-sticker img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: rotate(-8deg);
  }

  .hero-sub {
    font-weight: 700;
    /* 19px floor: red-on-postit passes contrast as large text only, and
       bold text qualifies as "large" from 18.66px up. */
    font-size: clamp(19px, 2vw, 28px);
    line-height: 1.25;
    max-width: 30ch;
    margin: 0 auto 24px;
  }

  .hero-sub em {
    font-style: normal;
    color: var(--stand-red);
  }

