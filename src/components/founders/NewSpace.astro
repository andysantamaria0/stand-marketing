---
// "A new space" statement slide — post-it ground, big sans statement, serif
// tagline under it. Promoted out of the facts card to its own beat per
// Aug 20 review; same statement-slide structure as the retired IntroPitch.
---

<section class="fc-newspace" aria-labelledby="newspace-title">
  <div class="inner">
    <h2 id="newspace-title">
      A new space for learning entrepreneurial skills. Designed for kids with
      big ideas.
    </h2>

    <p class="sub">
      Stand is where kids create, build and grow real businesses. The modern
      lemonade stand for the next generation.
    </p>
  </div>
</section>

<style>
  .fc-newspace {
    background: var(--stand-postit);
  }

  .inner {
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 8vh, 96px) 48px clamp(48px, 7vh, 80px);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(30px, 4vw, 58px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--stand-black);
  }

  .sub {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(17px, 1.5vw, 22px);
    line-height: 1.3;
    color: var(--stand-black);
  }

  @media (max-width: 768px) {
    .inner {
      padding: 48px 20px;
    }
  }
</style>
