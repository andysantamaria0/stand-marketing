---
// Huge closing enrollment CTA — red ground, the headline at poster scale.
// The hero line returns here deliberately (bookend), with the real scarcity
// line under the button. CTA is the shared paper-tag rectangle, same as
// every other signup moment on the page.
import SignupButton from './SignupButton.astro';
---

<section class="fc-closing" aria-labelledby="closing-title">
  <h2 id="closing-title">Build your own thing. <em>For Real.</em></h2>
  <SignupButton label="Apply for the Class →" />
  <p class="seats">Up to 20 seats this fall. First come.</p>
</section>

<style>
  .fc-closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-3);
    background: var(--stand-red);
    color: var(--stand-cream);
  }

  .fc-closing h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(40px, 6.5vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    max-width: 14ch;
    text-wrap: balance;
  }

  .fc-closing h2 em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    color: var(--stand-postit);
  }

  .seats {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 16px;
  }

  @media (max-width: 768px) {
    .fc-closing {
      padding: var(--space-7) var(--space-3);
    }
  }
</style>
