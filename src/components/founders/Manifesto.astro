---
// Green manifesto screen (Figma frame "2"): serif hook line, the three-beat
// "real" statement in big Authentic Sans, a giant post-it STAND wordmark, and
// a left-aligned paper-tag "learn more" CTA. The wordmark reuses logo.svg as
// a CSS mask so the background color IS the glyph color (same trick as the
// /masterclass nav) — no second logo asset to keep in sync.
import SignupButton from './SignupButton.astro';
---

<section class="fc-manifesto" aria-labelledby="manifesto-title">
  <div class="inner">
    <p class="hook">Who said kid play had to be imaginary?</p>

    <h2 id="manifesto-title">
      Learn real skills. Create a real brand. Build real confidence.
    </h2>

    <div class="wordmark" aria-hidden="true"></div>

    <div class="cta">
      <SignupButton label="learn more" href="#program" />
    </div>
  </div>
</section>

<style>
  .fc-manifesto {
    background: var(--stand-green);
    color: var(--stand-white);
  }

  /* Mock column is 1132px inside the 1437px frame; padding makes up the rest. */
  .inner {
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(64px, 7.7vw, 111px) 48px clamp(48px, 5.3vw, 76px);
  }

  .hook {
    margin: 0 0 clamp(24px, 3.3vw, 48px);
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(22px, 2.8vw, 40px);
    line-height: normal;
  }

  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    /* Mock says 100px; pulled back to 80px max per Aug 20 review. */
    font-size: clamp(40px, 5.6vw, 80px);
    line-height: 1.18;
    letter-spacing: 0;
  }

  /* Giant wordmark, post-it on green. Sized by the column, shaped by the
     logo's own viewBox so the mask never letterboxes. */
  .wordmark {
    width: 100%;
    aspect-ratio: 199.29 / 47.33;
    margin-top: clamp(16px, 2.2vw, 32px);
    background: var(--stand-postit);
    -webkit-mask: url('/brand/logo.svg') no-repeat center / contain;
    mask: url('/brand/logo.svg') no-repeat center / contain;
  }

  /* Block wrapper neutralizes the button's own align-self so it sits on the
     column's left edge, per the mock. */
  .cta {
    margin-top: clamp(40px, 5.5vw, 80px);
  }

  @media (max-width: 768px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
