---
// Red-bar nav (Figma HEADER): Early Access tag at left, two section links
// centered, "Already have an account? LOG IN" at right. Solid founder-red at
// all times — no transparent/scrolled state, no wordmark.
const TABS = [
  { label: 'The Flow', href: '#flow' },
  { label: 'As a CEO', href: '#program' },
];
---

<nav class="fc-nav" aria-label="Main">
  <a href="/enroll" class="early-access">
    <picture aria-hidden="true">
      <source srcset="/brand/early-access-tag.webp" type="image/webp" />
      <img src="/brand/early-access-tag.png" alt="" width="250" height="41" />
    </picture>
    <span>Early Access Here</span>
  </a>

  <div class="tabs">
    {TABS.map((t) => <a href={t.href}>{t.label}</a>)}
  </div>

  <a href="https://app.standkids.com" class="login">
    Already have an account? <strong>LOG IN</strong>
  </a>
</nav>

<style>
  .fc-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 14px 48px;
    background: var(--stand-red);
  }

  /* Center the tabs on the bar itself, not in the leftover flex space —
     otherwise the unequal tag/login widths push them off-axis. */
  .tabs {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 32px;
  }

  .tabs a {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--stand-white);
  }

  .tabs a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .early-access {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 250px;
    aspect-ratio: 250 / 41;
  }

  .early-access picture,
  .early-access picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .early-access span {
    position: relative;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: var(--stand-black);
    transform: translateY(-2px);
  }

  .login {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: var(--stand-white);
  }

  .login strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 900;
    margin-left: 4px;
  }

  @media (max-width: 1024px) {
    .tabs {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .fc-nav {
      padding: 10px 20px;
    }

    .early-access {
      width: 180px;
    }

    .early-access span {
      font-size: 13px;
      letter-spacing: -0.24px;
    }

    .login {
      font-size: 12px;
    }
  }
</style>
