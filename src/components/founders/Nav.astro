      <path d="M198.88,38.04c0,2.94.12,4.91.4,6.87.09.65-.42,1.24-1.07,1.24h-17.21c-.56,0-1.03-.43-1.08-.99l-.33-3.86h-.12c-2.43,4.08-6.16,6.04-11.25,6.04-9.35,0-14.03-6.57-14.03-19.24s5.15-19.83,15.57-19.83c3.85,0,6.87.89,9.23,2.72h.12V1.09c0-.6.49-1.09,1.09-1.09h17.6c.6,0,1.09.49,1.09,1.09v36.95h0ZM174.85,27.8c0,3.61.65,4.91,2.49,4.91.38,0,.72-.05,1.03-.15.45-.14.75-.57.75-1.03v-7.46c0-.47-.3-.89-.75-1.03-.31-.1-.65-.15-1.03-.15-1.83,0-2.49,1.3-2.49,4.91h0Z" />
    </svg>
  </a>

  <div class="right"
    <div class="tabs">
      {TABS.map((t) => <a href={t.href}>{t.label}</a>)}
    </div>
    <a href="https://app.standkids.com" class="login">Log in</a>
    <a href="/enroll" class="apply">Apply for the Class &rarr;</a>
  </div>
</nav>

<style>
  .fc-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 26px 48px;
    background: transparent;
    transition:
      background 0.3s ease,
      padding 0.3s ease;
  }

  /* Scrolled: condense onto the brand-red surface (same trigger that flips
     the wordmark black and small). */
  .fc-nav.scrolled {
    padding: 12px 48px;
    background: var(--stand-red);
  }

  /* Wordmark scroll state: red and oversized while the page sits at the top,
     easing to black at nav scale once scrolling starts. */
  .wordmark {
    height: 48px;
    width: auto;
    fill: var(--stand-red);
    transition:
      height 0.35s ease,
      fill 0.35s ease;
  }

  .fc-nav.scrolled .wordmark {
    height: 25px; /* matches the previous 104px-wide logo */
    fill: var(--stand-black);
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .tabs {
    display: flex;
    gap: 28px;
  }

  .tabs a,
  .login {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 16px;
    color: var(--stand-black);
  }

  .tabs a:hover,
  .login:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .apply {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 16px;
    color: var(--stand-black);
    background: var(--color-cta);
    border-radius: 999px;
    padding: 12px 24px;
    transition: transform 120ms ease;
  }

  .apply:hover {
    transform: scale(1.04);
  }

  @media (max-width: 1024px) {
    .tabs {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .fc-nav {
      padding: 18px 20px;
    }

    .fc-nav.scrolled {
      padding: 10px 20px;
    }

    .login {
      display: none;
    }

    .wordmark {
      height: 34px;
    }

    .fc-nav.scrolled .wordmark {
      height: 20px;
    }

    .apply {
      font-size: 14px;
      padding: 10px 18px;
    }
  }
</style>

<script>
  // Toggle the wordmark's top-of-page state. scrollY still updates normally
  // under Lenis (it drives native scroll), so a passive listener is enough.
  const nav = document.querySelector('.fc-nav');
  if (nav) {
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
