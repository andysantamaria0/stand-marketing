---
// Cream-bar nav: red stand wordmark at left (logo.svg as a CSS mask, so the
// background color IS the glyph color), two section links centered, "Already
// have an account? LOG IN" at right. Solid cream at all times — no
// transparent/scrolled state.
const TABS = [
  { label: 'The Flow', href: '#flow' },
  { label: 'As a CEO', href: '#program' },
];
---

<nav class="fc-nav" aria-label="Main">
  <a href="/" class="brand" aria-label="Stand — home">
    <span class="nav-logo"></span>
  </a>

  <div class="tabs">
    {TABS.map((t) => <a href={t.href}>{t.label}</a>)}
  </div>

  <a href="https://app.standkids.com" class="login">
    Already have an account? <strong>LOG IN</strong>
  </a>
</nav>

<style>
  .fc-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 14px 48px;
    background: var(--stand-cream);
  }

  /* Center the tabs on the bar itself, not in the leftover flex space —
     otherwise the unequal tag/login widths push them off-axis. */
  .tabs {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 32px;
  }

  .tabs a {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--stand-black);
  }

  .tabs a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .brand {
    line-height: 0;
  }

  /* Masked box: the background paints the wordmark, so recoloring is a
     one-token change. Sized against logo.svg's own viewBox. */
  .nav-logo {
    display: block;
    width: 120px;
    aspect-ratio: 199.29 / 47.33;
    background: var(--stand-red);
    -webkit-mask: url('/brand/logo.svg') no-repeat center / contain;
    mask: url('/brand/logo.svg') no-repeat center / contain;
  }

  .login {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: var(--stand-black);
  }

  .login strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 900;
    margin-left: 4px;
  }

  @media (max-width: 1024px) {
    .tabs {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .fc-nav {
      padding: 10px 20px;
    }

    .nav-logo {
      width: 90px;
    }

    .login {
      font-size: 12px;
    }
  }
</style>
