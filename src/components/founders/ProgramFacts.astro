---
// Post-it facts card (Figma frame "57"): the "what a kid walks away with"
// pitch (moved here from the retired pink walk-away band per Aug 19 review),
// the receipt-dash fact table (carried over from the retired program split —
// the mock literally screenshots it), and a left-aligned paper-tag CTA.
// Follows the green manifesto; id="program" keeps the nav's "As a CEO"
// anchor working and is the manifesto's "learn more" target.
import SignupButton from './SignupButton.astro';

const FACTS = [
  { k: 'Format', v: '8-week in-person semester' },
  { k: 'Ages', v: '8–13' },
  { k: 'Where', v: 'Westwood, LA' },
];
---

<section class="fc-facts" id="program" aria-labelledby="facts-title">
  <div class="inner">
    <h2 id="facts-title">what a kid walks away with</h2>

    <p class="pitch">
      Every kid takes an idea, one they came in with or one they find here,
      and builds it into a real business: a brand, a product, a plan. On pitch
      night they get up and present it. Kids get a Founder&rsquo;s grab bag
      and a member card they can hold, and a STAND login where their business
      lives online, so they can keep building their idea after the semester
      ends.
    </p>

    <p class="lead">
      A new space for learning entrepreneurial skills. Designed for kids with
      big ideas.
    </p>

    <dl class="facts">
      {
        FACTS.map((f) => (
          <div class="row">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>

    <div class="cta">
      <SignupButton />
    </div>
  </div>
</section>

<style>
  .fc-facts {
    background: var(--stand-postit);
    color: var(--stand-black);
  }

  /* Same 1132px column as the manifesto above it. */
  .inner {
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 6.1vw, 88px) 48px clamp(56px, 6.3vw, 90px);
  }

  /* The mock's card line (Figma node 769:994), set under the pitch. */
  .lead {
    margin: clamp(20px, 2.2vw, 32px) 0 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(18px, 2.1vw, 30px);
    line-height: normal;
  }

  h2 {
    margin: 0 0 clamp(16px, 1.7vw, 24px);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.3vw, 33px);
    line-height: 1.2;
  }

  .pitch {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(18px, 2.1vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  /* Receipt-style rule: ~6px dashes on an 11px rhythm. A repeating gradient
     because `border: dashed` can't control dash length or gap. */
  .facts {
    margin: clamp(32px, 3.8vw, 55px) 0 0;
    display: flex;
    flex-direction: column;
    --dash: repeating-linear-gradient(
      to right,
      rgba(0, 0, 0, 0.55) 0 6px,
      transparent 6px 11px
    );
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 18px 0;
    background-image: var(--dash);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 100% 1px;
  }

  .row:first-child {
    background-image: var(--dash), var(--dash);
    background-position:
      left bottom,
      left top;
    background-size: 100% 1px;
  }

  dt {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 18px;
  }

  dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }

  .cta {
    margin-top: clamp(40px, 4.6vw, 66px);
  }

  @media (max-width: 768px) {
    .inner {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
