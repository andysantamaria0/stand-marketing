---
// Full-bleed kid moment (Figma "HEADER (7)") — portrait photo cover-cropped
// into the comp's landscape frame, yellow type lockup layered on top, binder
// clip straddling the top seam as if pinning the photo to the page.
---

<section class="fc-moment">
  <img
    class="photo"
    src="/brand/kid-moment.jpg"
    alt="A kid at a craft table covered in beads, holding a white box wrapped in STAND tape"
    loading="lazy"
    width="2000"
    height="3000"
  />

  <img
    class="lockup"
    src="/brand/lockup-build-for-real.png"
    alt="Build your own thing. For Real."
    loading="lazy"
    width="776"
    height="676"
  />

  <img
    class="clip"
    src="/brand/clip-yellow.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    width="353"
    height="406"
  />
</section>

<style>
  .fc-moment {
    position: relative;
    /* No overflow:hidden — the binder clip must poke above the top seam.
       The photo itself is inset:0 + cover, so nothing else can spill. */
    /* The comp's landscape frame; the portrait photo crops into it. */
    aspect-ratio: 1437 / 1054;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bias the crop toward the STAND box (middle band of the portrait). */
    object-position: 50% 42%;
  }

  .lockup {
    position: absolute;
    /* Anchored to the top of the frame (not centered) so the type sits over
       the bead spill and the STAND box below stays clear. */
    top: 5%;
    left: 23%;
    width: 53%;
    height: auto;
  }

  .clip {
    position: absolute;
    /* Straddles the top seam like it's pinning the photo up; nudged right of
       the lockup so the type stays clear. */
    top: 0;
    left: 62%;
    width: clamp(60px, 7vw, 100px);
    height: auto;
    transform: translateY(-42%) rotate(6deg);
    pointer-events: none;
  }
</style>
