---
// Full-bleed kid moment (Figma frame "3") — portrait photo dimmed toward
// black, the "Build your own thing. For Real." lockup in white layered on
// top. The white comes from a filter on the existing yellow lockup PNG
// (brightness(0) flattens it to a silhouette, invert(1) flips it white), so
// there's no second lockup asset to keep in sync.
---

<section class="fc-moment">
  <img
    class="photo"
    src="/brand/kid-moment.jpg"
    alt="A kid at a craft table covered in beads, holding a white box wrapped in STAND tape"
    loading="lazy"
    width="2000"
    height="3000"
  />

  <img
    class="lockup"
    src="/brand/lockup-build-for-real.png"
    alt="Build your own thing. For Real."
    loading="lazy"
    width="776"
    height="676"
  />
</section>

<style>
  .fc-moment {
    position: relative;
    /* The comp's landscape frame; the portrait photo crops into it. */
    aspect-ratio: 1437 / 823;
    /* Black ground + 70% photo = the mock's scrim; it's what keeps the
       white lockup legible over the busy bead spill. */
    background: var(--stand-black);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bias the crop toward the STAND box (middle band of the portrait). */
    object-position: 50% 42%;
    opacity: 0.7;
  }

  .lockup {
    position: absolute;
    /* Centered with the mock's slight rightward bias (+81px of 1437),
       spanning nearly the full frame height. */
    top: 12%;
    left: 56%;
    transform: translateX(-50%);
    width: 50%;
    height: auto;
    /* Yellow PNG → white silhouette. */
    filter: brightness(0) invert(1);
  }
</style>
