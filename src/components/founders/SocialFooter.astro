---
// Minimal footer — cream strip with just the Instagram / TikTok marks
// (black on cream). Replaces the full yellow Footer per Aug 20 review.
// Icon markup carried over from Footer.astro so the glyphs stay identical.
---

<footer class="fc-footer">
  <a href="https://www.instagram.com/buildwithstand" aria-label="Instagram">
    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="2" width="20" height="20" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
    </svg>
  </a>
  <a href="https://www.tiktok.com/@buildwithstand" aria-label="TikTok">
    <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
      <path d="M16 3v3a4 4 0 0 0 4 4v3a7 7 0 0 1-4-1.3V16a5 5 0 1 1-5-5v3a2 2 0 1 0 2 2V3h3z"></path>
    </svg>
  </a>
</footer>

<style>
  .fc-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    padding: clamp(28px, 4vh, 48px) 24px;
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  /* 32px glyphs padded out to a 44px tap target. */
  .fc-footer a {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
  }
</style>
