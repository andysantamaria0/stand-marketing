---
// Idea → Make → Build → Pitch — the 8 weeks compressed into four beats.
// Product art from the existing brand set: lightbulb = the idea, paint =
// making, box = putting it all together, megaphone = pitch night.
const STEPS = [
  {
    title: 'Idea',
    icon: 'STAND_PNG_YellowLightbulb',
    rot: -5,
    body: '<Beat copy — come in with an idea or find one here>',
  },
  {
    title: 'Make',
    icon: 'STAND_PNG_PinkPaint',
    rot: 4,
    body: '<Beat copy — brand, product, made with their hands>',
  },
  {
    title: 'Build',
    icon: 'STAND_PNG_GreenBox',
    rot: -4,
    body: '<Beat copy — put it all together: the product, the plan, the price>',
  },
  {
    title: 'Pitch',
    icon: 'STAND_PNG_YellowMegaphone',
    rot: 6,
    body: '<Beat copy — pitch night, up in front of everyone>',
  },
];
---

<section class="fc-journey" aria-labelledby="journey-title">
  <p class="eyebrow">How it works</p>
  <h2 id="journey-title" class="headline-xl">Idea to pitch night, in eight weeks.</h2>

  <ol class="steps">
    {
      STEPS.map((s) => (
        <li class="step">
          <picture class="art" style={`--rot:${s.rot}deg`} aria-hidden="true">
            <source srcset={`/brand/${s.icon}.webp`} type="image/webp" />
            <img src={`/brand/${s.icon}.webp`} alt="" loading="lazy" width="120" height="120" />
          </picture>
          <h3>{s.title}</h3>
          <p class="desc">{s.body}</p>
        </li>
      ))
    }
  </ol>

  <a href="/enroll" class="apply">Apply for the Class &rarr;</a>
</section>

<style>
  .fc-journey {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-5);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    color: var(--stand-red);
  }

  .headline-xl {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    width: 100%;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .art {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(var(--rot));
    transition: transform 160ms ease;
  }

  .step:hover .art {
    transform: rotate(0deg) scale(1.06);
  }

  .art img {
    object-fit: contain;
    width: 100%;
    height: 100%;
  }

  .step h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 26px;
  }

  .step .desc {
    margin: 0;
    max-width: 30ch;
  }

  .apply {
    margin-top: var(--space-4);
    font-weight: 700;
    font-size: 18px;
    color: var(--stand-black);
    background: var(--color-cta);
    border-radius: 999px;
    padding: 14px 28px;
    transition: transform 120ms ease;
  }

  .apply:hover {
    transform: scale(1.04);
  }

  @media (max-width: 900px) {
    .fc-journey {
      padding: var(--space-6) var(--space-3);
    }

    .steps {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5) var(--space-3);
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
