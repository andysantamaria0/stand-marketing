---
import Nav from './Nav.astro';

// Hero — full-screen film under the red nav bar: the video fills the rest of
// the viewport edge-to-edge, lede overlaid upper-left, headline at poster
// scale overlaid across the bottom. A soft bottom scrim keeps the type
// readable over moving footage.
//
// The film streams from the same Vercel Blob asset the production site uses —
// video binaries stay out of git. If the blob is ever rotated, grab the new
// URL from the live site's <video> source.
const FILM_SRC =
  'https://mk7xj0szdtkawdqj.public.blob.vercel-storage.com/video/stand-website-v2-RzQBNxWaJiAOJwSAv6dveovpSRwsLH.mp4';
---

<section class="fc-hero" aria-labelledby="fc-hero-title">
  <Nav />

  <video autoplay muted loop playsinline preload="metadata" aria-label="Stand — the film">
    <source src={FILM_SRC} type="video/mp4" />
  </video>

  <!-- Visually clean film; the h1 stays for the document outline and the
       section's aria-labelledby, just hidden from view. -->
  <h1 id="fc-hero-title" class="sr-only">Build your own thing. For Real.</h1>

  <!-- Sound toggle — the film autoplays muted (browser requirement); this
       lets the visitor opt into audio. Icon pair swaps on data-muted. -->
  <button type="button" id="fc-hero-sound" class="sound" data-muted="true" aria-label="Turn sound on">
    <svg class="icon icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 5 6 9H3v6h3l5 4V5z" fill="currentColor" stroke="none" />
      <line x1="16" y1="9" x2="21" y2="14" />
      <line x1="21" y1="9" x2="16" y2="14" />
    </svg>
    <svg class="icon icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 5 6 9H3v6h3l5 4V5z" fill="currentColor" stroke="none" />
      <path d="M15.5 8.5a5 5 0 0 1 0 7" />
      <path d="M18.5 5.5a9 9 0 0 1 0 13" />
    </svg>
  </button>
</section>

<style>
  .fc-hero {
    position: relative;
    /* Full screen minus the fixed red bar — the film starts under it. */
    margin-top: var(--header-h);
    height: calc(100svh - var(--header-h));
    overflow: hidden;
    /* Dark ground doubles as the placeholder until the film loads. */
    background: #191512;
  }

  .fc-hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .sound {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 2px solid var(--stand-cream);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    color: var(--stand-cream);
    cursor: pointer;
    transition: transform 120ms ease, background-color 120ms ease;
  }

  .sound:hover {
    transform: scale(1.08);
    background: rgba(0, 0, 0, 0.55);
  }

  .sound:focus-visible {
    outline: 3px solid var(--stand-postit);
    outline-offset: 2px;
  }

  .sound .icon {
    width: 24px;
    height: 24px;
  }

  .sound[data-muted='true'] .icon-on,
  .sound[data-muted='false'] .icon-off {
    display: none;
  }
</style>

<script>
  // Muted flag flips directly on the <video>; the button mirrors it for the
  // icon swap and assistive tech. Unmuting also nudges play() in case the
  // browser paused the film when audio was requested.
  const hero = document.querySelector('.fc-hero');
  const film = hero?.querySelector('video');
  const toggle = document.getElementById('fc-hero-sound');
  if (film && toggle) {
    toggle.addEventListener('click', () => {
      film.muted = !film.muted;
      if (!film.muted) film.play()?.catch(() => {});
      toggle.dataset.muted = String(film.muted);
      toggle.setAttribute('aria-label', film.muted ? 'Turn sound on' : 'Turn sound off');
    });
  }
</script>
