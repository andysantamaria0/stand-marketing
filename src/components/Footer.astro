---
// FOOTER — Figma node 202:2993
// Yellow post-it bg. Stand wordmark + tagline + social, email signup tag, 4 columns of links.
// Signup posts to the existing waitlist endpoint on app.standkids.com — same handler the legacy site used.
// `signup={false}` drops the email card (used on /masterclass, which has its
// own signup form) — the footer is then just the brand sign-off.
interface Props {
  signup?: boolean;
}

const { signup = true } = Astro.props;
---

<footer class="footer">
  <div class:list={['inner', { 'brand-only': !signup }]}>
    <div class="brand">
      {signup ? (
        <img src="/brand/logo.svg" alt="Stand" width="120" />
      ) : (
        <!-- Logo gag: the wordmark is inlined per-letter so the "t" can do a
             little hop — crouch, jump, squash-land, settle into its lean.
             Plays once when the footer scrolls into view (see script). -->
        <span class="logo-stage" role="img" aria-label="Stand">
          <svg class="logo-svg" viewBox="0 0 199.29 47.33" aria-hidden="true">
            <path d="M36.3,10.69l-.47,11.15c-.03.78-.85,1.27-1.56.94-2.01-.92-4.96-1.5-8.23-1.5h-.11c-1.36,0-1.48,2-.13,2.16,7.93.96,11.84,4.52,11.84,10.86,0,9.71-5.39,13.02-20.78,13.02-4.49,0-9.68-.43-15.67-1.33-.55-.08-.95-.57-.93-1.12l.48-11.77c.03-.77.83-1.26,1.53-.94,2.37,1.07,5.91,1.73,9.61,1.73.4,0,.77,0,1.12-.02,1.36-.04,1.41-2.05.06-2.16C4.32,30.94,0,27.53,0,21.28c0-9.71,5.39-13.02,20.78-13.02,4.73,0,9.63.42,14.63,1.31.54.1.92.57.9,1.12h0Z" />
            <path class="letter-t" d="M56.66,8.75l5.08-.55c.6-.07,1.13.37,1.2.96l1.32,12.08c.07.6-.37,1.13-.96,1.2l-5.08.55c-.6.07-1.03.6-.96,1.2l.28,2.57c.19,1.71.96,2.28,3.2,2.03.94-.1,1.9-.32,2.89-.7.67-.26,1.4.18,1.47.89l1.6,14.73c.06.5-.25.98-.73,1.15-3.13,1.08-5.2,1.56-8.35,1.9-12.83,1.4-18.05-2.26-19.25-13.32l-3.18-29.03c-.07-.6.37-1.13.96-1.2l17.5-1.9c.6-.07,1.13.36,1.2.96l.61,5.54c.07.6.6,1.03,1.2.96h0Z" />
            <path d="M107.42,26.67v11.37c0,2.94.12,4.91.4,6.87.09.65-.42,1.24-1.07,1.24h-16.52c-.51,0-.94-.35-1.06-.84l-.57-2.47h-.12c-2.37,2.96-6.27,4.5-11.42,4.5-7.64,0-11.37-3.37-11.37-10.3s3.97-10.54,12.13-10.54c3.73,0,7.34.71,9.65,1.89h.12v-.12c0-3.02-2.66-4.38-8.58-4.38-3.93,0-7.7.61-10.29,1.67-.69.28-1.46-.22-1.49-.97l-.5-13.9c-.02-.54.36-1.02.9-1.11,4.89-.84,10.55-1.31,16.11-1.31,17.64,0,23.68,4.68,23.68,18.41h0ZM83.63,36.08c0,2.31.59,3.02,2.25,3.02.33,0,.62-.02.88-.09.49-.11.84-.56.84-1.06v-3.74c0-.5-.35-.95-.84-1.06-.26-.06-.55-.09-.88-.09-1.66,0-2.25.71-2.25,3.02Z" />
            <path d="M152.73,23.06v22c0,.6-.49,1.09-1.09,1.09h-17.6c-.6,0-1.09-.49-1.09-1.09v-18.98c0-2.37-.53-3.2-2.07-3.2-.38,0-.76.06-1.12.18-.43.15-.72.57-.72,1.03v20.97c0,.6-.49,1.09-1.09,1.09h-17.6c-.6,0-1.09-.49-1.09-1.09V10.53c0-.6.49-1.09,1.09-1.09h16.8c.56,0,1.03.43,1.08.99l.33,3.86h.12c2.6-4.2,6.33-6.04,12.13-6.04,8.64,0,11.9,4.08,11.9,14.8h0Z" />
            <path d="M198.88,38.04c0,2.94.12,4.91.4,6.87.09.65-.42,1.24-1.07,1.24h-17.21c-.56,0-1.03-.43-1.08-.99l-.33-3.86h-.12c-2.43,4.08-6.16,6.04-11.25,6.04-9.35,0-14.03-6.57-14.03-19.24s5.15-19.83,15.57-19.83c3.85,0,6.87.89,9.23,2.72h.12V1.09c0-.6.49-1.09,1.09-1.09h17.6c.6,0,1.09.49,1.09,1.09v36.95h0ZM174.85,27.8c0,3.61.65,4.91,2.49,4.91.38,0,.72-.05,1.03-.15.45-.14.75-.57.75-1.03v-7.46c0-.47-.3-.89-.75-1.03-.31-.1-.65-.15-1.03-.15-1.83,0-2.49,1.3-2.49,4.91h0Z" />
          </svg>
        </span>
      )}
      <p>STAND&reg; is where kids create, launch, and grow real businesses.</p>
      <div class="social">
        <a href="https://www.instagram.com/buildwithstand" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="https://www.tiktok.com/@buildwithstand" aria-label="TikTok">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
            <path d="M16 3v3a4 4 0 0 0 4 4v3a7 7 0 0 1-4-1.3V16a5 5 0 1 1-5-5v3a2 2 0 1 0 2 2V3h3z" />
          </svg>
        </a>
      </div>
    </div>

    {signup && (
    <div class="right-stack">
      <form
        class="signup"
        id="waitlist-form"
        data-source="footer"
        aria-label="Email signup"
        novalidate
      >
        <div class="signup-card">
          <picture class="signup-bg" aria-hidden="true">
            <source srcset="/brand/sticker-card.webp" type="image/webp" />
            <img src="/brand/sticker-card.png" alt="" />
          </picture>
          <input
            type="email"
            name="email"
            id="waitlist-email"
            placeholder="hello@standkids.com"
            aria-label="Email address"
            required
            autocomplete="email"
          />
          <div class="signup-confirmed" aria-live="polite">
            <svg class="check" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="5 12 10 17 19 7" />
            </svg>
            <span class="confirmed-text">
              <strong>You&rsquo;re on the waitlist.</strong>
              <em>We&rsquo;ll be in touch soon.</em>
            </span>
          </div>
        </div>
        <a href="/enroll" class="signup-btn">Sign Up &rarr;</a>
      </form>
      <p class="signup-status" id="signup-status" role="status" aria-live="polite"></p>
    </div>
    )}
  </div>
</footer>

<script>
  // POSTs to the existing stand-app waitlist endpoint (CORS allows standkids.com).
  //
  // The previous version auto-rendered the "you're on the waitlist" confirmation
  // any time a `stand_waitlist_signed_up = '1'` localStorage flag was set. That
  // produced a critical false-positive: anyone who'd ever submitted any email
  // on this device saw the confirmation card forever, and re-submissions with
  // a different email were swallowed because the input was hidden behind the
  // confirmation. Andy hit this on 2026-05-29 — typed a new test email, saw
  // the success message, but nothing landed in Supabase or Klaviyo because the
  // form never actually fired.
  //
  // Fix: the confirmation card only renders after a real POST returns 200.
  // No persistent flag — returning visitors see an empty input again, which is
  // a minor UX downgrade in exchange for guaranteed truthful state. Supabase
  // de-dupes by unique email, so re-submissions are idempotent no-ops.
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const status = document.getElementById('signup-status');
  const input = document.getElementById('waitlist-email') as HTMLInputElement | null;

  // The placeholder is styled like real text, so it reads as a pre-filled value.
  // Clear it on focus (incl. when the Sign Up button focuses an empty field) so
  // people see an empty, editable field; restore it on blur if still empty.
  input?.addEventListener('focus', () => { if (input) input.placeholder = ''; });
  input?.addEventListener('blur', () => { if (input && !input.value) input.placeholder = 'hello@standkids.com'; });

  // The footer doesn't capture emails itself — "Sign Up →" routes to /enroll,
  // the marketing site's own capture surface (per the 8/18 decision; it used
  // to hand off to the app). Pressing Enter in the email field follows the
  // same path, not a POST.
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    window.location.href = '/enroll';
  });

  // Logo hop gag (brand-only footer): the "t" jumps once, the first time the
  // logo scrolls into view. The observer never attaches under reduced motion,
  // so the wordmark just renders statically there.
  const stage = document.querySelector<HTMLElement>('.logo-stage');
  if (stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          stage.classList.add('is-playing');
          io.disconnect();
        }
      },
      { threshold: 0.6 }
    );
    io.observe(stage);
  }

  // Smooth-scroll all "early-access" links to the footer signup.
  document.querySelectorAll<HTMLAnchorElement>('a[data-scroll="waitlist"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.getElementById('waitlist-form');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => input?.focus(), 600);
      }
    });
  });
</script>

<style>
  .footer {
    background: var(--stand-postit);
    padding: 40px 0 24px;
    width: 100%;
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 94px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  /* signup={false}: no right column, the brand block owns the row and
     rearranges — a big "long" wordmark on the left, tagline + socials beside
     it. The logo spans both right-column rows so the pair reads as one
     lockup, not a list. */
  .inner.brand-only {
    grid-template-columns: 1fr;
  }

  .inner.brand-only .brand {
    display: grid;
    /* One row: logo · description · socials. The 1fr middle pushes the
       social icons to the far edge. */
    grid-template-columns: auto 1fr auto;
    column-gap: clamp(24px, 3vw, 44px);
    align-items: center;
  }

  .inner.brand-only .brand > img,
  .inner.brand-only .logo-stage {
    width: clamp(72px, 7vw, 100px);
    height: auto;
    margin-bottom: 0;
  }

  /* ── Logo gag — the "t" does a Pixar-style hop ───────────────────────────
     Crouch, jump with stretch, squash on landing, spring wobble, then settle
     into a slight left lean. All transforms are anchored to the letter's own
     baseline (fill-box), so it moves like a character standing on the line. */
  .logo-stage {
    position: relative;
    display: block;
  }

  .logo-svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--stand-black);
  }

  .logo-svg path {
    fill: currentColor;
  }

  /* The brand's t leans LEFT by design (it's baked into the path). The gag:
     start it counter-rotated +4° so it reads as vertical-upright, hop, and
     let the landing knock it into its designed lean — rotate(0) IS the real
     logo, so the animation ends on the untouched wordmark. */
  .letter-t {
    transform-box: fill-box;
    transform-origin: bottom center;
    transform: rotate(4deg);
  }

  .logo-stage.is-playing .letter-t {
    animation: t-hop 1.6s cubic-bezier(0.45, 0, 0.55, 1) 0.3s both;
  }

  @media (prefers-reduced-motion: reduce) {
    /* No animation will ever un-straighten it, so show the designed logo. */
    .letter-t {
      transform: none;
    }
  }

  /* translateY %s resolve against the letter's own height. */
  @keyframes t-hop {
    /* upright — the pre-lean pose */
    0% {
      transform: translateY(0) scale(1, 1) rotate(4deg);
    }
    /* crouch — gathering the jump */
    18% {
      transform: translateY(0) scale(1.12, 0.82) rotate(4deg);
    }
    /* airborne — stretched tall at the apex, lean beginning */
    42% {
      transform: translateY(-60%) scale(0.92, 1.1) rotate(1deg);
    }
    /* squash on landing — knocked to its designed angle */
    62% {
      transform: translateY(0) scale(1.18, 0.78) rotate(0deg);
    }
    /* spring wobble — a touch past the lean */
    76% {
      transform: translateY(0) scale(0.97, 1.06) rotate(-2deg);
    }
    /* settle: the logo as the brand designer drew it */
    88%,
    100% {
      transform: translateY(0) scale(1, 1) rotate(0deg);
    }
  }

  .inner.brand-only .brand p {
    margin: 0;
    /* One long line beside the logo — drop the base rule's 280px wrap cap. */
    max-width: none;
  }

  .right-stack {
    display: flex;
    flex-direction: column;
  }

  .brand > img,
  .brand .logo-stage {
    margin-bottom: 16px;
  }

  .brand p {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.392vw, 20px);
    line-height: 1.4;
    color: var(--stand-black);
    margin: 0 0 28px;
    max-width: 280px;
  }

  .social {
    display: flex;
    gap: 16px;
    color: var(--stand-black);
  }

  /* Form has two pieces: a sticker-card "card" holding the email input, and a
     "Sign Up →" submit button. Desktop puts the button inside the card on the
     right; mobile drops the button below the card as a separate link. */
  .signup {
    position: relative;
    max-width: 849px;
    width: 100%;
    justify-self: end;
  }

  .signup-card {
    position: relative;
    width: 100%;
    aspect-ratio: 849 / 130;
    padding: 32px 60px 42px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  .signup-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .signup-bg img {
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .signup input {
    position: relative;
    z-index: 1;
    flex: 1;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 28px;
    line-height: 1;
    color: var(--stand-black);
    outline: none;
    min-width: 0;
    text-align: center;
    /* Reserve the right ~22% of the input for the absolutely-positioned
       "Sign Up →" button. Without this, the centered placeholder/email
       extends across the full input width and overlaps the button. */
    padding-right: 22%;
  }

  .signup input::placeholder {
    color: var(--stand-black);
    opacity: 1;
  }

  .signup .signup-btn {
    position: absolute;
    z-index: 2;
    right: 7%;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.4px;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    color: var(--stand-black);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  /* "You're on the waitlist" confirmation overlay — replaces the input + button
     after a successful submit (and on subsequent visits via localStorage). */
  .signup-confirmed {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 0 32px;
    text-align: center;
    color: var(--stand-black);
  }

  .signup-confirmed .check {
    flex-shrink: 0;
    color: var(--stand-red);
  }

  .signup-confirmed .confirmed-text {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.1;
  }

  .signup-confirmed strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 2.088vw, 30px);
    letter-spacing: -0.4px;
  }

  .signup-confirmed em {
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(12px, 1.113vw, 16px);
    margin-top: 2px;
  }

  .signup.is-confirmed input,
  .signup.is-confirmed > .signup-btn {
    visibility: hidden;
  }

  .signup.is-confirmed .signup-confirmed {
    display: flex;
  }

  .signup-status {
    margin: 12px 0 0;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--stand-black);
    min-height: 1.2em;
  }

  .signup-status:empty {
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 36px 0 40px;
    }
    .inner {
      padding: 0 28px;
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .brand > img {
      width: 160px;
      height: auto;
    }
    .brand p {
      font-size: 16px;
      max-width: none;
    }
    /* brand-only goes back to a stack at phone width — 220px+ of wordmark
       plus a paragraph doesn't fit side by side. */
    .inner.brand-only .brand {
      grid-template-columns: 1fr;
      row-gap: 4px;
    }
    .inner.brand-only .brand > img,
    .inner.brand-only .logo-stage {
      grid-row: auto;
      width: 90px;
      margin-bottom: 12px;
    }
    .inner.brand-only .brand p {
      align-self: auto;
      margin: 0 0 20px;
    }
    .signup {
      justify-self: stretch;
      max-width: 100%;
    }
    .signup-card {
      aspect-ratio: 849 / 130;
      padding: 16px 14px 26px;
    }
    .signup input {
      font-size: clamp(16px, 5.1vw, 18px);
      min-width: 0;
      width: 100%;
      padding-right: 0;
    }
    .signup .signup-btn {
      position: static;
      transform: none;
      display: block;
      margin: 14px auto 0;
      font-size: 16px;
      text-align: center;
    }
    .signup-bg img {
      object-fit: fill;
    }
    .signup-confirmed {
      gap: 8px;
      padding: 0 18px;
    }
    .signup-confirmed .check {
      width: 22px;
      height: 22px;
    }
    .signup-confirmed strong {
      font-size: clamp(14px, 5vw, 18px);
      letter-spacing: 0;
    }
    .signup-confirmed em {
      font-size: clamp(10px, 3.8vw, 12px);
    }
  }
</style>
